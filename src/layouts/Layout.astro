---
import "../styles/global.css";
import type { Locale } from "../i18n/index";

interface Props {
    title?: string;
    description?: string;
    lang: Locale;
}

const BASE_URL = import.meta.env.PUBLIC_SITE_URL ?? "https://ikl.pistation.dev";

const { lang, title: titleProp, description: descProp } = Astro.props;

const defaultTitles: Record<string, string> = {
    es: "Iker Lorente Calvo — Desarrollador Full Stack e Ingeniero Informático",
    en: "Iker Lorente Calvo — Full Stack Developer & Software Engineer",
    eu: "Iker Lorente Calvo — Full Stack Garatzailea eta Informatika Ingeniaria",
};

const defaultDescriptions: Record<string, string> = {
    es: "Portfolio de Iker Lorente Calvo, Ingeniero Informático y Desarrollador Full Stack con más de 7 años de experiencia en PHP, Laravel, Python, Android y DevOps. Basado en el País Vasco.",
    en: "Portfolio of Iker Lorente Calvo, Computer Engineer and Full Stack Developer with 7+ years of experience in PHP, Laravel, Python, Android and DevOps. Based in the Basque Country, Spain.",
    eu: "Iker Lorente Calvoren portfolio profesionala. Informatika Ingeniaria eta Full Stack Garatzailea, 7 urte baino gehiagoko esperientziarekin PHP, Laravel, Python, Android eta DevOps-en.",
};

const title = titleProp ?? defaultTitles[lang];
const description = descProp ?? defaultDescriptions[lang];

const canonicalURL = new URL(Astro.url.pathname, BASE_URL).href;
const ogImageURL = `${BASE_URL}/images/profile.jpg`;
const ogLocale: Record<string, string> = { es: "es_ES", en: "en_US", eu: "eu_ES" };

const pathNoLocale = Astro.url.pathname.replace(/^\/(es|en|eu)/, "") || "/";
const hreflangs = [
    { hreflang: "es", href: `${BASE_URL}/es${pathNoLocale}` },
    { hreflang: "en", href: `${BASE_URL}/en${pathNoLocale}` },
    { hreflang: "eu", href: `${BASE_URL}/eu${pathNoLocale}` },
    { hreflang: "x-default", href: `${BASE_URL}/` },
];

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Iker Lorente Calvo",
    alternateName: ["Iker Lorente", "ikerlorente11"],
    url: BASE_URL,
    image: ogImageURL,
    email: "ikerlorentecalvo@gmail.com",
    telephone: "+34665341338",
    jobTitle: "Software Engineer",
    description:
        "Ingeniero Informático y Desarrollador Full Stack con más de 7 años de experiencia",
    nationality: { "@type": "Country", name: "Spain" },
    address: {
        "@type": "PostalAddress",
        addressCountry: "ES",
        addressRegion: "País Vasco",
    },
    sameAs: [
        "https://www.linkedin.com/in/iker-lorente-calvo-37314118b",
        "https://github.com/ikerlorente11",
    ],
    knowsAbout: [
        "PHP",
        "Python",
        "JavaScript",
        "TypeScript",
        "Java",
        "Laravel",
        "FastAPI",
        "React",
        "Vue",
        "Astro",
        "Android Development",
        "Docker",
        "Google Cloud",
        "AWS",
        "MySQL",
        "MongoDB",
        "Git",
    ],
};
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- Primary SEO -->
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Iker Lorente Calvo" />
        <meta name="robots" content="index, follow" />
        <meta
            name="keywords"
            content="Iker Lorente, Iker Lorente Calvo, portfolio, desarrollador, full stack, PHP, Laravel, Python, Android, DevOps, País Vasco, software engineer"
        />
        <link rel="canonical" href={canonicalURL} />

        <!-- hreflang: idiomas alternativos -->
        {
            hreflangs.map(({ hreflang, href }) => (
                <link rel="alternate" hreflang={hreflang} href={href} />
            ))
        }

        <!-- Open Graph -->
        <meta property="og:type" content="profile" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:alt" content="Iker Lorente Calvo" />
        <meta property="og:image:width" content="800" />
        <meta property="og:image:height" content="800" />
        <meta property="og:locale" content={ogLocale[lang]} />
        <meta property="og:site_name" content="Iker Lorente Calvo" />
        <meta property="profile:first_name" content="Iker" />
        <meta property="profile:last_name" content="Lorente Calvo" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />
        <meta name="twitter:image:alt" content="Iker Lorente Calvo" />

        <!-- Iconos -->
        <link rel="icon" type="image/png" href="/favicon.png?v=2" />
        <link rel="icon" type="image/x-icon" href="/favicon.png?v=2" />

        <!-- JSON-LD: Person schema para búsquedas de nombre -->
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

        <!-- Prevent FOUC: apply saved theme before render -->
        <script is:inline>
            (function () {
                const saved = localStorage.getItem("theme");
                const prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                document.documentElement.setAttribute(
                    "data-theme",
                    saved ? saved : prefersDark ? "dark" : "light",
                );
            })();
        </script>
    </head>
    <body>
        <slot />

        <!-- NES Controller overlay (mobile Easter Egg) -->
        <div id="nes-ctrl" aria-hidden="true">
            <div class="nes-wrap">
                <!-- Imagen real del mando NES -->
                <img
                    src="/images/nes.png"
                    alt=""
                    class="nes-img"
                    draggable="false"
                />
                <!--
              Posiciones calculadas sobre imagen 1536×660 px:
              D-pad UP:    x213-357, y255-367  → left13.9% top38.6% w9.4% h17%
              D-pad DOWN:  x213-357, y413-525  → left13.9% top62.6% w9.4% h17%
              D-pad LEFT:  x115-227, y363-417  → left7.5%  top55%   w7.3% h8.2%
              D-pad RIGHT: x343-455, y363-417  → left22.3% top55%   w7.3% h8.2%
              SELECT oval: x590-725, y455-540  → left38.4% top68.9% w8.8% h12.9%
              START  oval: x782-918, y455-540  → left50.9% top68.9% w8.8% h12.9%
              B square:    x1082-1260,y420-575 → left70.4% top63.6% w11.6% h23.5%
              A square:    x1278-1456,y420-575 → left83.2% top63.6% w11.6% h23.5%
            -->
                <button
                    class="nes-hit"
                    data-k="ArrowUp"
                    style="left:13.9%;top:27%;width:9.4%;height:22%;border-radius:4px 4px 0 0"
                ></button>
                <button
                    class="nes-hit"
                    data-k="ArrowDown"
                    style="left:13.9%;top:62.6%;width:9.4%;height:17%;border-radius:0 0 4px 4px"
                ></button>
                <button
                    class="nes-hit"
                    data-k="ArrowLeft"
                    style="left:7.5%;top:45.5%;width:7.3%;height:17%;border-radius:4px 0 0 4px"
                ></button>
                <button
                    class="nes-hit"
                    data-k="ArrowRight"
                    style="left:22.3%;top:45.5%;width:7.3%;height:17%;border-radius:0 4px 4px 0"
                ></button>
                <button
                    class="nes-hit"
                    data-k="select"
                    style="left:38.4%;top:68.9%;width:8.8%;height:12.9%;border-radius:20px"
                ></button>
                <button
                    class="nes-hit"
                    data-k="start"
                    style="left:50.9%;top:68.9%;width:8.8%;height:12.9%;border-radius:20px"
                ></button>
                <button
                    class="nes-hit"
                    data-k="b"
                    style="left:68.5%;top:62%;width:8%;height:18.5%;border-radius:50%"
                ></button>
                <button
                    class="nes-hit"
                    data-k="a"
                    style="left:81.5%;top:62%;width:8%;height:18.5%;border-radius:50%"
                ></button>
            </div>
        </div>

        <style is:global>
            /* ── NES Controller (SVG overlay) ────────────────── */
            #nes-ctrl {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                z-index: 9999;
                padding-bottom: env(safe-area-inset-bottom, 0px);
                transform: translateY(100%);
                transition: transform 0.65s cubic-bezier(0.22, 0.61, 0.36, 1);
                will-change: transform;
            }
            #nes-ctrl.visible {
                transform: translateY(0);
            }
            .nes-wrap {
                position: relative;
                max-width: 560px;
                margin: 0 auto;
                line-height: 0;
            }
            .nes-img {
                display: block;
                width: 100%;
                height: auto;
                user-select: none;
                pointer-events: none;
            }
            .nes-hit {
                position: absolute;
                background: transparent;
                border: none;
                cursor: pointer;
                -webkit-tap-highlight-color: transparent;
                touch-action: manipulation;
                user-select: none;
                padding: 0;
            }
            .nes-hit:active {
                background: rgba(255, 255, 255, 0.18);
            }
        </style>

        <!-- Konami Code (keyboard + SNES controller + shake) -->
        <script is:inline>
            (function () {
                var KONAMI = [
                    "ArrowUp",
                    "ArrowUp",
                    "ArrowDown",
                    "ArrowDown",
                    "ArrowLeft",
                    "ArrowRight",
                    "ArrowLeft",
                    "ArrowRight",
                    "b",
                    "a",
                ];
                var idx = 0;
                var ctrl = document.getElementById("nes-ctrl");

                function handleInput(key) {
                    if (key === KONAMI[idx]) {
                        idx++;
                        if (idx === KONAMI.length) {
                            var locale = document.documentElement.lang || "es";
                            sessionStorage.setItem("easterEggUnlocked", "1");
                            window.location.href =
                                "/" + locale + "/easter-egg/";
                        }
                    } else {
                        idx = key === KONAMI[0] ? 1 : 0;
                    }
                }

                // Keyboard
                document.addEventListener("keydown", function (e) {
                    handleInput(e.key);
                });

                // Controller buttons
                document.querySelectorAll("[data-k]").forEach(function (btn) {
                    btn.addEventListener("pointerdown", function (e) {
                        e.preventDefault();
                        handleInput(btn.getAttribute("data-k"));
                    });
                });

                // Close on tap outside the controller
                document.addEventListener("pointerdown", function (e) {
                    if (
                        ctrl.classList.contains("visible") &&
                        !ctrl.contains(e.target)
                    ) {
                        ctrl.classList.remove("visible");
                        idx = 0;
                    }
                });

                // Shake detection
                var lastShakeTime = 0;
                var lastAcc = { x: 0, y: 0, z: 0 };

                // 5 taps/clicks rápidos en el logo ILC (touchstart en móvil, click en desktop)
                var tapCount = 0,
                    tapTimer = null;
                var logo = document.querySelector(".nav-logo");
                if (logo) {
                    function onLogoActivate(e) {
                        e.preventDefault(); // evita navegación y doble disparo click tras touchstart
                        tapCount++;
                        if (tapTimer) clearTimeout(tapTimer);
                        if (tapCount >= 5) {
                            tapCount = 0;
                            ctrl.classList.add("visible");
                        } else {
                            tapTimer = setTimeout(function () {
                                tapCount = 0;
                            }, 1200);
                        }
                    }
                    logo.addEventListener("touchstart", onLogoActivate, {
                        passive: false,
                    });
                    logo.addEventListener("click", onLogoActivate);
                }

                function onShake() {
                    var now = Date.now();
                    if (now - lastShakeTime > 1000) {
                        lastShakeTime = now;
                        ctrl.classList.add("visible");
                    }
                }

                // Shake por touch: 3 cambios de dirección horizontal en < 600ms
                var shakeDir = 0, shakeSwitches = 0, shakeStart = 0, shakeLast = 0;
                document.addEventListener("touchstart", function (e) {
                    shakeLast = e.touches[0].clientX;
                    shakeDir = 0;
                    shakeSwitches = 0;
                    shakeStart = Date.now();
                }, { passive: true });
                document.addEventListener("touchmove", function (e) {
                    if (!e.touches.length) return;
                    var x = e.touches[0].clientX;
                    var diff = x - shakeLast;
                    if (Math.abs(diff) < 10) return;
                    var dir = diff > 0 ? 1 : -1;
                    if (shakeDir !== 0 && dir !== shakeDir) {
                        shakeSwitches++;
                        if (shakeSwitches >= 3 && Date.now() - shakeStart < 600) {
                            shakeSwitches = 0;
                            shakeStart = Date.now();
                            onShake();
                        }
                    }
                    shakeDir = dir;
                    shakeLast = x;
                }, { passive: true });
            })();
        </script>

        <!-- Scroll reveal observer -->
        <script is:inline>
            document.addEventListener("DOMContentLoaded", function () {
                const observer = new IntersectionObserver(
                    function (entries) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("visible");
                            }
                        });
                    },
                    { threshold: 0.1 },
                );
                document.querySelectorAll(".reveal").forEach(function (el) {
                    observer.observe(el);
                });
            });
        </script>
    </body>
</html>
