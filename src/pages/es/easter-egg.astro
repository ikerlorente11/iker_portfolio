---
import { getTranslations } from "../../i18n/index";
const lang = "es" as const;
const t = getTranslations(lang);
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <script is:inline>
            if (sessionStorage.getItem("easterEggUnlocked") !== "1") {
                window.location.replace("/es/");
            } else {
                sessionStorage.removeItem("easterEggUnlocked");
            }
        </script>
        <style>
            *,
            *::before,
            *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }
            :root {
                --bg: #09090b;
                --border: rgba(255, 255, 255, 0.07);
                --accent: #7c3aed;
                --accent-light: #a78bfa;
                --accent-2: #06b6d4;
                --text-muted: #a1a1aa;
            }
            body {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                background: var(--bg);
                font-family: "Space Grotesk", system-ui, sans-serif;
                overflow: hidden;
            }
            body::before {
                content: "";
                position: fixed;
                top: -20%;
                left: 50%;
                transform: translateX(-50%);
                width: 600px;
                height: 600px;
                background: radial-gradient(
                    circle,
                    rgba(124, 58, 237, 0.13) 0%,
                    transparent 70%
                );
                pointer-events: none;
                z-index: 0;
            }
            body::after {
                content: "";
                position: fixed;
                bottom: -10%;
                right: 10%;
                width: 400px;
                height: 400px;
                background: radial-gradient(
                    circle,
                    rgba(6, 182, 212, 0.09) 0%,
                    transparent 70%
                );
                pointer-events: none;
                z-index: 0;
            }
            .egg-card {
                position: relative;
                z-index: 1;
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid var(--border);
                border-radius: 24px;
                padding: 2.5rem 3rem;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 1.5rem;
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                box-shadow: 0 8px 40px rgba(0, 0, 0, 0.45);
                max-width: 440px;
                width: calc(100% - 2rem);
                text-align: center;
            }
            .roll-ring {
                position: relative;
                width: clamp(180px, 42vmin, 280px);
                height: clamp(180px, 42vmin, 280px);
                flex-shrink: 0;
            }
            .roll-ring::before {
                content: "";
                position: absolute;
                inset: -5px;
                border-radius: 50%;
                background: conic-gradient(
                    var(--accent) 0deg,
                    var(--accent-2) 130deg,
                    transparent 170deg,
                    transparent 340deg,
                    var(--accent) 360deg
                );
                z-index: 0;
            }
            .roll-ring::after {
                content: "";
                position: absolute;
                inset: -3px;
                border-radius: 50%;
                background: var(--bg);
                z-index: 1;
            }
            @keyframes spin {
                from {
                    transform: rotate(0deg);
                }
                to {
                    transform: rotate(360deg);
                }
            }
            .roll-img {
                position: relative;
                z-index: 2;
                width: 100%;
                height: 100%;
                border-radius: 50%;
                object-fit: cover;
                display: block;
                animation: spin 10s linear infinite;
            }
            .roll-ring.pulsing {
                animation: pulse 1s ease-in-out infinite;
            }
            @keyframes pulse {
                0% {
                    transform: scale(1);
                }
                50% {
                    transform: scale(1.1);
                }
                100% {
                    transform: scale(1);
                }
            }
            .egg-badge {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                padding: 0.28rem 0.85rem;
                border-radius: 100px;
                background: rgba(124, 58, 237, 0.14);
                border: 1px solid rgba(124, 58, 237, 0.3);
                color: var(--accent-light);
                font-size: 0.75rem;
                font-weight: 600;
                letter-spacing: 0.06em;
            }
            .egg-title {
                font-size: clamp(1.2rem, 3vw, 1.65rem);
                font-weight: 700;
                background: linear-gradient(
                    135deg,
                    var(--accent-light),
                    var(--accent-2)
                );
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                line-height: 1.3;
            }
            .egg-text {
                font-size: clamp(0.87rem, 2.2vw, 0.97rem);
                color: var(--text-muted);
                line-height: 1.75;
            }
            .stars {
                position: fixed;
                inset: 0;
                pointer-events: none;
                z-index: 0;
            }
            .star {
                position: absolute;
                border-radius: 50%;
                animation: twinkle var(--d, 3s) ease-in-out infinite alternate;
                opacity: 0;
            }
            .star.violet {
                background: var(--accent-light);
            }
            .star.cyan {
                background: var(--accent-2);
            }
            .star.white {
                background: #e2e8f0;
            }
            @keyframes twinkle {
                from {
                    opacity: 0;
                }
                to {
                    opacity: var(--o, 0.7);
                }
            }
        </style>
    </head>
    <body>
        <div class="stars" id="stars"></div>
        <div class="egg-card">
            <div class="roll-ring">
                <img
                    id="roll"
                    class="roll-img"
                    src="/images/roll.jpg"
                    alt=""
                    draggable="false"
                />
            </div>
            <h1 class="egg-title">{t.easterEgg.title}</h1>
            <p class="egg-text">{t.easterEgg.text}</p>
        </div>
        <audio id="pedro" src="/music/pedro.mp3" preload="auto" autoplay
        ></audio>
        <script is:inline>
            var container = document.getElementById("stars");
            var colors = ["violet", "cyan", "white"];
            for (var i = 0; i < 80; i++) {
                var s = document.createElement("div");
                s.className =
                    "star " + colors[Math.floor(Math.random() * colors.length)];
                var sz = Math.random() * 3 + 1;
                s.style.cssText =
                    "width:" +
                    sz +
                    "px;height:" +
                    sz +
                    "px;" +
                    "top:" +
                    (Math.random() * 100).toFixed(2) +
                    "%;" +
                    "left:" +
                    (Math.random() * 100).toFixed(2) +
                    "%;" +
                    "--d:" +
                    (Math.random() * 4 + 1.5).toFixed(1) +
                    "s;" +
                    "--o:" +
                    (Math.random() * 0.6 + 0.2).toFixed(2) +
                    ";" +
                    "animation-delay:" +
                    (Math.random() * 3).toFixed(1) +
                    "s;";
                container.appendChild(s);
            }
            var audio = document.getElementById("pedro");
            var img = document.getElementById("roll");
            audio.volume = 0.2;
            audio.play().catch(function () {});
            setTimeout(function () {
                img.parentElement.classList.add("pulsing");
            }, 6500);
            ["click", "keydown", "touchstart", "pointerdown"].forEach(
                function (evt) {
                    document.addEventListener(evt, function handler() {
                        audio.play().catch(function () {});
                        document.removeEventListener(evt, handler);
                    });
                },
            );
        </script>
    </body>
</html>
