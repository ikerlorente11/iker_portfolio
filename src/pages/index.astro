---
// Fallback para `astro dev` / `astro preview`, donde no hay nginx delante.
// En producción nginx responde a "/" con un 302 al idioma (cookie "lang" o
// Accept-Language) y esta página nunca se sirve. Ver nginx.conf.
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Iker Lorente Calvo</title>
    <script is:inline>
      var saved = localStorage.getItem("lang-preference");
      if (saved === "es" || saved === "en" || saved === "eu") {
        location.replace("/" + saved + "/");
      } else {
        var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
        var isSpain = tz === "Europe/Madrid" || tz === "Atlantic/Canary";
        location.replace(isSpain ? "/es/" : "/en/");
      }
    </script>
  </head>
  <body>
    <noscript>
      <ul>
        <li><a href="/es/">Español</a></li>
        <li><a href="/en/">English</a></li>
        <li><a href="/eu/">Euskara</a></li>
      </ul>
    </noscript>
  </body>
</html>
