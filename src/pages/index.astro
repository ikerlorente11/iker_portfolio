---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
---

<Layout title="Welcome to Astro.">
	<main>
		<img src="iker.jpg" alt="" />
		<audio id="miAudio" hidden loop>
			<source src="pedro.mp3" type="audio/mpeg" />
			Tu navegador no soporta el elemento de audio.
		</audio>
		<h1>Iker</h1>
	</main>

	<script>
		const audio = document.getElementById("miAudio") as HTMLAudioElement;

		audio.volume = 0.3;
		audio.play();

		window.addEventListener("focus", () => {
			// Reproducir el audio cuando la pestaña está enfocada
			audio.play();
		});

		// Agregar evento de blur a la pestaña
		window.addEventListener("blur", () => {
			// Parar el audio cuando la pestaña no está enfocada
			audio.pause();
		});
	</script>
</Layout>

<style>
	html,
	body {
		height: 100%;
	}

	main {
		height: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
		flex-direction: column;
	}

	main img {
		border-radius: 50%;
		border: 5px solid white;
		animation: pedro 6s linear infinite;
	}

	h1 {
		color: white;
		font-size: 60px;
		margin-top: 5px;
		margin-bottom: 0;
		animation: escalar 0.6s linear infinite;
		animation-delay: 6500ms;
	}

	@keyframes pedro {
		0% {
			transform: rotate(0deg);
		}
		50% {
			transform: rotate(180deg);
		}
		100% {
			transform: rotate(360deg);
		}
	}

	@keyframes escalar {
		0%,
		100% {
			transform: scale(1);
		}
		50% {
			transform: scale(1.2);
		}
	}
</style>
