---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
---

<Layout title="Welcome to Astro.">
	<main>
		<h1>Do you what to meet Iker?</h1>
		<a href="home">Lets go</a>
	</main>
</Layout>

<style>
	html,
	body {
		height: 100%;
	}

	main {
		height: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
		flex-direction: column;
	}

	h1 {
		font-size: 60px;
		color: white;
	}

	a {
		font-size: 60px;
		color: black;
		background: white;
		border-radius: 20px;
		padding: 10px 25px;
		text-decoration: none;
		transition: transform 0.2s;
	}

	a:hover {
		transform: scale(1.2);
	}
</style>
