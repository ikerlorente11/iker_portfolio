---
import type { Locale } from "../i18n/index";
import { getTranslations } from "../i18n/index";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const d = t.desktop;

// Apps de escritorio para Windows. Se renderiza dentro de la sección Projects,
// tras el carrusel de apps Android. Cada tarjeta lleva a su página de detalle;
// la descarga va en un enlace aparte.
const apps = [
    {
        key: "pctoolkit",
        logo: "/images/pctoolkit/logo.webp",
        screenshot: "/images/pctoolkit/screenshot.webp",
        stack: "PowerShell · WPF",
        download: "https://github.com/ikerlorente11/pc-toolkit/releases/latest/download/PCToolkit-Setup.exe",
        text: d.pctoolkit,
    },
    {
        key: "estanteria",
        logo: "/images/estanteria/logo_square_round.webp",
        screenshot: "/images/estanteria/desktop.webp",
        stack: "Tauri · Vue",
        download: "https://github.com/ikerlorente11/pc-toolkit",
        text: d.estanteria,
    },
] as const;
---

<div class="desktop-grid" id="desktop-apps">
    {
        apps.map((app) => (
            <article class="desk-card">
                <a href={`/${lang}/projects/${app.key}/`} class="desk-main">
                    <!-- Barra de ventana de Windows -->
                    <div class="win-bar">
                        <img src={app.logo} alt="" class="win-icon" width="16" height="16" loading="lazy" />
                        <span class="win-title">{app.text.title}</span>
                        <span class="win-controls" aria-hidden="true">
                            <svg width="10" height="10" viewBox="0 0 10 10"><path d="M1 5h8" stroke="currentColor" stroke-width="1" /></svg>
                            <svg width="10" height="10" viewBox="0 0 10 10"><rect x="1" y="1" width="8" height="8" fill="none" stroke="currentColor" stroke-width="1" /></svg>
                            <svg width="10" height="10" viewBox="0 0 10 10"><path d="M1 1l8 8M9 1l-8 8" stroke="currentColor" stroke-width="1" /></svg>
                        </span>
                    </div>

                    <div class="desk-shot">
                        <img
                            src={app.screenshot}
                            alt={`${app.text.title} — ${d.platform}`}
                            width="1200"
                            height="750"
                            loading="lazy"
                            decoding="async"
                        />
                    </div>

                    <div class="desk-body">
                        <div class="desk-header">
                            <img src={app.logo} alt={app.text.title} class="desk-logo" width="52" height="52" loading="lazy" />
                            <div>
                                <h3 class="desk-name">{app.text.title}</h3>
                                <span class="desk-platform">{d.platform} · {app.stack}</span>
                            </div>
                        </div>
                        <p class="desk-desc">{app.text.description}</p>
                    </div>
                </a>
                <a href={app.download} target="_blank" rel="noopener" class="desk-download">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                    {app.key === "pctoolkit" ? d.download : `${d.download} (PC Toolkit)`}
                </a>
            </article>
        ))
    }
</div>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    gsap.from(".desk-card", {
        scrollTrigger: { trigger: "#desktop-apps", start: "top 85%" },
        y: 40,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: "power3.out",
        clearProps: "transform,opacity",
    });
</script>

<style>
    .desktop-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
        margin-bottom: 1.25rem;
    }

    .desk-card {
        position: relative;
        display: flex;
        flex-direction: column;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        background: var(--bg-elevated);
        overflow: hidden;
        transition:
            border-color 0.25s ease,
            box-shadow 0.25s ease;
    }
    .desk-card:hover {
        border-color: var(--border-hover);
        box-shadow: var(--shadow-glow);
    }

    .desk-main {
        display: flex;
        flex-direction: column;
        flex: 1;
        text-decoration: none;
        color: var(--text);
    }
    .desk-main:hover {
        color: var(--text);
    }

    /* ── Barra de ventana (estilo Windows 11) ─────── */
    .win-bar {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.55rem 0.9rem;
        background: #1f1f23;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .win-icon {
        width: 16px;
        height: 16px;
        border-radius: 4px;
    }
    .win-title {
        flex: 1;
        font-size: 0.74rem;
        color: #c9d1d9;
        font-family: "Segoe UI", system-ui, sans-serif;
    }
    .win-controls {
        display: inline-flex;
        gap: 1.1rem;
        color: #8b949e;
    }

    /* ── Captura ──────────────────────────────────── */
    .desk-shot {
        aspect-ratio: 16 / 10;
        overflow: hidden;
        background: #0d1117;
        border-bottom: 1px solid var(--border);
    }
    .desk-shot img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        display: block;
        transition: transform 0.5s ease;
    }
    .desk-card:hover .desk-shot img {
        transform: scale(1.03);
    }

    /* ── Cuerpo ───────────────────────────────────── */
    .desk-body {
        flex: 1;
        padding: 1.35rem 1.35rem 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }
    .desk-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .desk-logo {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        object-fit: cover;
        flex-shrink: 0;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
    }
    .desk-name {
        font-family: "Space Grotesk", system-ui, sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.2;
    }
    .desk-platform {
        font-size: 0.68rem;
        color: #60a5fa;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }
    .desk-desc {
        font-size: 0.82rem;
        color: var(--text-muted);
        line-height: 1.55;
    }

    .desk-download {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        align-self: flex-start;
        margin: 0.4rem 1.35rem 1.35rem;
        background: var(--accent-dim);
        border: 1px solid var(--border-hover);
        border-radius: 100px;
        padding: 0.35rem 0.9rem;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--accent-light);
        text-decoration: none;
        transition: background 0.2s ease;
    }
    .desk-download:hover {
        background: rgba(124, 58, 237, 0.25);
    }

    @media (max-width: 768px) {
        .desktop-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
