---
import type { Locale } from "../i18n/index";
import { getTranslations } from "../i18n/index";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section class="hero" id="hero">
    <div class="container hero-inner">
        <div class="hero-photo-wrap reveal">
            <div class="photo-ring">
                <img
                    src="/images/profile.jpg"
                    alt="Iker Lorente Calvo"
                    class="hero-photo"
                    width="140"
                    height="140"
                />
            </div>
            <div class="photo-glow"></div>
        </div>

        <div class="hero-content">
            <p class="hero-eyebrow reveal">{t.hero.role}</p>
            <h1 class="hero-name reveal">Iker Lorente Calvo</h1>

            <div class="hero-contacts reveal">
                <a
                    href="mailto:ikerlorentecalvo@gmail.com"
                    class="hero-contact-item"
                    aria-label="Email"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><rect x="2" y="4" width="20" height="16" rx="2"
                        ></rect><path
                            d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                        ></path></svg
                    >
                    <span>ikerlorentecalvo@gmail.com</span>
                </a>
                <a
                    href="tel:+34665341338"
                    class="hero-contact-item"
                    aria-label="Phone"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.14 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.06 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21 16z"
                        ></path></svg
                    >
                    <span>+34 665 341 338</span>
                </a>
                <span class="hero-contact-item">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
                        ></path><circle cx="12" cy="10" r="3"></circle></svg
                    >
                    <span>{t.hero.location}</span>
                </span>
                <a
                    href="https://www.linkedin.com/in/iker-lorente-calvo-37314118b"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hero-contact-item"
                    aria-label="LinkedIn"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        ><path
                            d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                        ></path><rect x="2" y="9" width="4" height="12"
                        ></rect><circle cx="4" cy="4" r="2"></circle></svg
                    >
                    <span>linkedin.com/in/ikerlorentecalvo</span>
                </a>
            </div>

            <div class="hero-langs reveal">
                {
                    t.langBadges.map((b) => (
                        <span class="hero-lang-badge">
                            <span>{b.lang}</span>
                            <span class="badge-level">{b.level}</span>
                        </span>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes spin-ring {
        to { --ring-angle: 360deg; }
    }

    @keyframes pulse-glow {
        0%, 100% { opacity: 0.5; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.06); }
    }

    @keyframes blink-cursor {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }

    .hero {
        padding-top: 5.5rem;
        padding-bottom: 3rem;
        border-bottom: 1px solid var(--border);
        position: relative;
        overflow: hidden;
    }

    /* Ambient blob */
    .hero::after {
        content: '';
        position: absolute;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.07) 0%, transparent 70%);
        top: -150px;
        right: -80px;
        pointer-events: none;
        border-radius: 50%;
    }

    .hero-inner {
        display: flex;
        align-items: center;
        gap: 3rem;
    }

    /* ── Photo ── */
    .hero-photo-wrap {
        flex-shrink: 0;
        position: relative;
    }

    .photo-ring {
        position: relative;
        width: 150px;
        height: 150px;
        border-radius: 50%;
        padding: 4px;
        background: conic-gradient(from var(--ring-angle), var(--accent), #8b5cf6, var(--accent-2), var(--accent));
        animation: spin-ring 4s linear infinite;
        box-shadow: 0 0 28px rgba(99, 102, 241, 0.4), 0 0 56px rgba(99, 102, 241, 0.12);
    }

    .hero-photo {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        display: block;
        background: var(--bg);
    }

    .photo-glow {
        position: absolute;
        inset: -18px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.18) 0%, transparent 70%);
        z-index: -1;
        animation: pulse-glow 3s ease-in-out infinite;
    }

    /* ── Text ── */
    .hero-content {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
    }

    .hero-eyebrow {
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--accent-light);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .hero-eyebrow::after {
        content: '|';
        color: var(--accent-2);
        animation: blink-cursor 1.1s step-end infinite;
        font-weight: 300;
    }

    .hero-name {
        font-size: clamp(2.1rem, 4.5vw, 3.2rem);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.03em;
        background: linear-gradient(135deg, var(--text) 0%, var(--accent-light) 55%, #a78bfa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-contacts {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
        margin-top: 0.1rem;
    }

    .hero-contact-item {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--text-muted);
        font-size: 0.875rem;
        transition: color 0.2s ease;
    }

    a.hero-contact-item:hover {
        color: var(--accent-light);
    }

    .hero-langs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-top: 0.2rem;
    }

    .hero-lang-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: var(--accent-dim);
        color: var(--accent-light);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 0.25rem 0.85rem;
        font-size: 0.8rem;
        font-weight: 500;
        transition: background 0.2s ease, border-color 0.2s ease;
    }

    .hero-lang-badge:hover {
        background: rgba(99, 102, 241, 0.22);
        border-color: var(--accent);
    }

    .badge-level {
        color: var(--text-faint);
        font-weight: 400;
        font-size: 0.75rem;
    }

    @media (max-width: 640px) {
        .hero-inner {
            flex-direction: column;
            text-align: center;
            gap: 2rem;
        }

        .hero-contacts {
            justify-content: center;
        }

        .hero-langs {
            justify-content: center;
        }

        .hero-eyebrow {
            justify-content: center;
        }
    }
</style>
