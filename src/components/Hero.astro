---
import type { Locale } from "../i18n/index";
import { getTranslations } from "../i18n/index";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const yearsExp = new Date().getFullYear() - 2017;

const roles = [
    t.hero.role,
    lang === "es"
        ? "Desarrollador Android"
        : lang === "eu"
          ? "Android Garatzailea"
          : "Android Developer",
    lang === "es"
        ? "Ingeniero de Software"
        : lang === "eu"
          ? "Software Ingeniaria"
          : "Software Engineer",
    lang === "es"
        ? "Entusiasta de DevOps"
        : lang === "eu"
          ? "DevOps Zalea"
          : "DevOps Enthusiast",
];
---

<section class="hero" id="hero">
    <!-- Ambient blobs -->
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>

    <div class="container hero-grid">
        <!-- Left: text -->
        <div class="hero-content">
            <p class="hero-eyebrow">
                {
                    lang === "es"
                        ? "Hola, soy"
                        : lang === "eu"
                          ? "Kaixo, ni naiz"
                          : "Hello, I'm"
                }
            </p>

            <h1 class="hero-name display">Iker<br />Lorente<br />Calvo</h1>

            <div class="hero-role-wrap">
                <span class="hero-role-prefix">/&gt;&nbsp;</span>
                <span class="hero-role-text" id="hero-role-text"></span>
                <span class="hero-cursor">|</span>
            </div>

            <div class="hero-contacts">
                <a
                    href="mailto:ikerlorentecalvo@gmail.com"
                    class="hero-contact-item"
                    aria-label="Email"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><rect x="2" y="4" width="20" height="16" rx="2"
                        ></rect><path
                            d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                        ></path></svg
                    >
                    <span>ikerlorentecalvo@gmail.com</span>
                </a>
                <a
                    href="tel:+34665341338"
                    class="hero-contact-item"
                    aria-label="Phone"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.14 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.06 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21 16z"
                        ></path></svg
                    >
                    <span>+34 665 341 338</span>
                </a>
                <span class="hero-contact-item">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
                        ></path><circle cx="12" cy="10" r="3"></circle></svg
                    >
                    <span>{t.hero.location}</span>
                </span>
                <a
                    href="https://www.linkedin.com/in/iker-lorente-calvo"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hero-contact-item"
                    aria-label="LinkedIn"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        ><path
                            d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                        ></path><rect x="2" y="9" width="4" height="12"
                        ></rect><circle cx="4" cy="4" r="2"></circle></svg
                    >
                    <span>LinkedIn</span>
                </a>
            </div>

            <div class="hero-langs">
                {
                    t.langBadges.map((b) => (
                        <span class="hero-lang-badge">
                            <span class="lang-name">{b.lang}</span>
                            <span class="lang-level">{b.level}</span>
                        </span>
                    ))
                }
            </div>
        </div>

        <!-- Right: photo -->
        <div class="hero-photo-col">
            <div class="photo-wrap">
                <div class="photo-ring">
                    <img
                        src="/images/profile.jpg"
                        alt="Iker Lorente Calvo"
                        class="hero-photo"
                        width="220"
                        height="220"
                    />
                </div>
                <div class="stat-chip stat-1">
                    <span class="stat-num">{yearsExp}+</span>
                    <span class="stat-label"
                        >{
                            lang === "es"
                                ? "años exp."
                                : lang === "eu"
                                  ? "urte esp."
                                  : "yrs exp."
                        }</span
                    >
                </div>
                <div class="stat-chip stat-2">
                    <span class="stat-num">Team</span>
                    <span class="stat-label">Lead</span>
                </div>
                <div class="stat-chip stat-3">
                    <span class="stat-num">Full</span>
                    <span class="stat-label">Stack</span>
                </div>
            </div>
        </div>
    </div>
</section>

<div
    id="hero-roles-data"
    data-roles={JSON.stringify(roles)}
    style="display:none"
>
</div>

<script>
    import gsap from "gsap";

    // ── Typing effect ──────────────────────────────────
    const rolesEl = document.getElementById("hero-roles-data");
    const roleText = document.getElementById("hero-role-text");
    if (rolesEl && roleText) {
        const roles: string[] = JSON.parse(rolesEl.dataset.roles || "[]");
        let ri = 0;
        let ci = 0;
        let deleting = false;
        const PAUSE_FULL = 2200;
        const PAUSE_EMPTY = 400;
        const SPEED_TYPE = 70;
        const SPEED_DEL = 38;

        function tick() {
            const current = roles[ri];
            if (!deleting) {
                roleText.textContent = current.slice(0, ci + 1);
                ci++;
                if (ci === current.length) {
                    deleting = true;
                    setTimeout(tick, PAUSE_FULL);
                    return;
                }
            } else {
                roleText.textContent = current.slice(0, ci - 1);
                ci--;
                if (ci === 0) {
                    deleting = false;
                    ri = (ri + 1) % roles.length;
                    setTimeout(tick, PAUSE_EMPTY);
                    return;
                }
            }
            setTimeout(tick, deleting ? SPEED_DEL : SPEED_TYPE);
        }
        setTimeout(tick, 800);
    }

    // ── GSAP entrance ──────────────────────────────────
    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
    tl.from(".hero-eyebrow", { y: 20, opacity: 0, duration: 0.6 })
        .from(".hero-name", { y: 40, opacity: 0, duration: 0.8 }, "-=0.3")
        .from(".hero-role-wrap", { y: 20, opacity: 0, duration: 0.5 }, "-=0.4")
        .from(".hero-contacts", { y: 16, opacity: 0, duration: 0.5 }, "-=0.3")
        .from(".hero-langs", { y: 16, opacity: 0, duration: 0.5 }, "-=0.3")
        .from(
            ".photo-wrap",
            { scale: 0.88, opacity: 0, duration: 0.9, ease: "back.out(1.4)" },
            "-=0.8",
        )
        .from(
            ".stat-chip",
            {
                scale: 0,
                opacity: 0,
                duration: 0.5,
                stagger: 0.12,
                ease: "back.out(2)",
            },
            "-=0.4",
        );
</script>

<style>
    @property --ring-angle {
        syntax: "<angle>";
        inherits: false;
        initial-value: 0deg;
    }

    @keyframes spin-ring {
        to {
            --ring-angle: 360deg;
        }
    }

    @keyframes floatBlob {
        0%,
        100% {
            transform: translate(0, 0) scale(1);
        }
        33% {
            transform: translate(30px, -40px) scale(1.05);
        }
        66% {
            transform: translate(-20px, 20px) scale(0.95);
        }
    }

    @keyframes blink {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0;
        }
    }

    @keyframes floatChip {
        0%,
        100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-8px);
        }
    }

    /* ── Section ────────────────────────────────────────── */
    .hero {
        min-height: 100svh;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
        padding: 5rem 0 3rem;
    }

    /* ── Blobs ──────────────────────────────────────────── */
    .blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        pointer-events: none;
        z-index: 0;
    }

    .blob-1 {
        width: 500px;
        height: 500px;
        background: rgba(124, 58, 237, 0.18);
        top: -100px;
        left: -100px;
        animation: floatBlob 12s ease-in-out infinite;
    }

    .blob-2 {
        width: 400px;
        height: 400px;
        background: rgba(6, 182, 212, 0.12);
        bottom: -80px;
        right: 10%;
        animation: floatBlob 15s ease-in-out infinite reverse;
    }

    .blob-3 {
        width: 300px;
        height: 300px;
        background: rgba(124, 58, 237, 0.08);
        top: 40%;
        left: 55%;
        animation: floatBlob 18s ease-in-out infinite 3s;
    }

    /* ── Grid layout ────────────────────────────────────── */
    .hero-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 4rem;
        position: relative;
        z-index: 1;
    }

    /* ── Text side ──────────────────────────────────────── */
    .hero-content {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
    }

    .hero-eyebrow {
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--text-muted);
        letter-spacing: 0.06em;
    }

    .hero-name {
        font-size: clamp(3.2rem, 6.5vw, 5.5rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.04em;
        background: linear-gradient(
            135deg,
            var(--text) 0%,
            var(--accent-light) 55%,
            var(--accent-2) 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-role-wrap {
        display: flex;
        align-items: center;
        font-size: 1.05rem;
        font-family: "Courier New", monospace;
        color: var(--accent-2);
        min-height: 1.6em;
    }

    .hero-role-prefix {
        color: var(--text-faint);
        margin-right: 2px;
    }

    .hero-role-text {
        color: var(--accent-2);
    }

    .hero-cursor {
        color: var(--accent-2);
        animation: blink 1.1s step-end infinite;
        margin-left: 2px;
    }

    .hero-contacts {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1rem;
        margin-top: 0.25rem;
    }

    .hero-contact-item {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--text-muted);
        font-size: 0.82rem;
        transition: color 0.2s ease;
    }

    a.hero-contact-item:hover {
        color: var(--accent-light);
    }

    .hero-langs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.1rem;
    }

    .hero-lang-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 100px;
        padding: 0.3rem 0.85rem;
        font-size: 0.8rem;
        font-weight: 500;
        transition:
            border-color 0.2s ease,
            background 0.2s ease;
    }

    .hero-lang-badge:hover {
        border-color: var(--accent);
        background: var(--accent-dim);
    }

    .lang-name {
        color: var(--text);
    }
    .lang-level {
        color: var(--text-faint);
        font-size: 0.75rem;
    }

    /* ── Photo side ─────────────────────────────────────── */
    .hero-photo-col {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .photo-wrap {
        position: relative;
        width: 260px;
        height: 260px;
    }

    .photo-ring {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        padding: 4px;
        background: conic-gradient(
            from var(--ring-angle),
            var(--accent),
            #8b5cf6,
            var(--accent-2),
            var(--accent)
        );
        animation: spin-ring 5s linear infinite;
        box-shadow:
            0 0 40px rgba(124, 58, 237, 0.35),
            0 0 80px rgba(124, 58, 237, 0.12);
    }

    .hero-photo {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        display: block;
        background: var(--bg);
    }

    /* ── Stat chips ─────────────────────────────────────── */
    .stat-chip {
        position: absolute;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 0.5rem 0.85rem;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
        min-width: 62px;
        text-align: center;
    }

    .stat-num {
        font-family: "Space Grotesk", system-ui, sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        background: linear-gradient(
            135deg,
            var(--accent-light),
            var(--accent-2)
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.1;
    }

    .stat-label {
        font-size: 0.68rem;
        color: var(--text-muted);
        font-weight: 500;
        white-space: nowrap;
    }

    .stat-1 {
        top: 0;
        right: -40px;
        animation: floatChip 4s ease-in-out infinite;
    }
    .stat-2 {
        bottom: 20px;
        right: -48px;
        animation: floatChip 5s ease-in-out infinite 1s;
    }
    .stat-3 {
        bottom: 10px;
        left: -40px;
        animation: floatChip 4.5s ease-in-out infinite 0.5s;
    }

    /* ── Responsive ─────────────────────────────────────── */
    @media (max-width: 768px) {
        .hero {
            padding: 5rem 0 3rem;
        }

        .hero-grid {
            grid-template-columns: 1fr;
            gap: 3rem;
            text-align: center;
        }

        .hero-photo-col {
            order: -1;
        }
        .photo-wrap {
            width: 200px;
            height: 200px;
        }

        .hero-contacts {
            justify-content: center;
        }
        .hero-langs {
            justify-content: center;
        }

        .stat-1 {
            right: -20px;
        }
        .stat-2 {
            right: -28px;
        }
        .stat-3 {
            left: -20px;
        }
    }

    @media (max-width: 480px) {
        .hero-name {
            font-size: clamp(2.5rem, 12vw, 3.5rem);
        }
    }
</style>
