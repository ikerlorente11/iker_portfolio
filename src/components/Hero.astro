---
import type { Locale } from "../i18n/index";
import { getTranslations } from "../i18n/index";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section class="hero" id="hero">
    <div class="container hero-inner">
        <div class="hero-photo-wrap reveal">
            <img
                src="/images/profile.jpg"
                alt="Iker Lorente Calvo"
                class="hero-photo"
                width="200"
                height="200"
            />
        </div>

        <div class="hero-content">
            <p class="hero-eyebrow reveal">{t.hero.role}</p>
            <h1 class="hero-name reveal">Iker Lorente Calvo</h1>

            <div class="hero-contacts reveal">
                <a
                    href="mailto:ikerlorentecalvo@gmail.com"
                    class="hero-contact-item"
                    aria-label="Email"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><rect x="2" y="4" width="20" height="16" rx="2"
                        ></rect><path
                            d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                        ></path></svg
                    >
                    <span>ikerlorentecalvo@gmail.com</span>
                </a>
                <a
                    href="tel:+34665341338"
                    class="hero-contact-item"
                    aria-label="Phone"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.14 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.06 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21 16z"
                        ></path></svg
                    >
                    <span>+34 665 341 338</span>
                </a>
                <span class="hero-contact-item">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
                        ></path><circle cx="12" cy="10" r="3"></circle></svg
                    >
                    <span>{t.hero.location}</span>
                </span>
                <a
                    href="https://www.linkedin.com/in/iker-lorente-calvo-37314118b"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hero-contact-item"
                    aria-label="LinkedIn"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        ><path
                            d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                        ></path><rect x="2" y="9" width="4" height="12"
                        ></rect><circle cx="4" cy="4" r="2"></circle></svg
                    >
                    <span>linkedin.com/in/ikerlorentecalvo</span>
                </a>
            </div>

            <div class="hero-langs reveal">
                {
                    t.langBadges.map((b) => (
                        <span class="hero-lang-badge">
                            <span>{b.lang}</span>
                            <span class="badge-level">{b.level}</span>
                        </span>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .hero {
        padding-top: 5.5rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--border);
    }

    .hero-inner {
        display: flex;
        align-items: center;
        gap: 2.5rem;
    }

    .hero-photo-wrap {
        flex-shrink: 0;
    }

    .hero-photo {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--accent);
        box-shadow: 0 0 0 5px var(--accent-dim);
    }

    .hero-content {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .hero-eyebrow {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--accent-light);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .hero-name {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        line-height: 1.1;
        color: var(--text);
        letter-spacing: -0.02em;
    }

    .hero-contacts {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.25rem;
        margin-top: 0;
    }

    .hero-contact-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--text-muted);
        font-size: 0.875rem;
        transition: color 0.2s ease;
    }

    a.hero-contact-item:hover {
        color: var(--accent-light);
    }

    .hero-langs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.15rem;
    }

    .hero-lang-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: var(--accent-dim);
        color: var(--accent-light);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 0.25rem 0.8rem;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .badge-level {
        color: var(--text-faint);
        font-weight: 400;
        font-size: 0.75rem;
    }

    .hero-lang-badge::before {
        content: "";
    }

    @media (max-width: 640px) {
        .hero-inner {
            flex-direction: column;
            text-align: center;
            gap: 2rem;
        }

        .hero-contacts {
            justify-content: center;
        }

        .hero-langs {
            justify-content: center;
        }
    }
</style>
