---
import type { Locale } from "../i18n/index";
import { getTranslations } from "../i18n/index";
import Webs from "./Webs.astro";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const p = t.projects;
---

<section id="projects">
    <div class="container">
        <h2 class="section-title">{t.projects.title}</h2>

        <!-- ── Terminal cards grid ── -->
        <div class="projects-grid">
            <!-- ── Terminal: PiStation Dev ── -->
            <a
                href="https://dev.pistation.dev"
                target="_blank"
                rel="noopener noreferrer"
                class="project-card terminal-card"
            >
                <div class="terminal-header">
                    <div class="terminal-dots">
                        <span class="dot dot-red"></span>
                        <span class="dot dot-yellow"></span>
                        <span class="dot dot-green"></span>
                    </div>
                    <span class="terminal-bar-title">dev.pistation.dev</span>
                </div>
                <div class="terminal-body">
                    <p class="t-line">
                        <span class="t-prompt">$</span>
                        <span class="t-cmd">pistation status</span>
                    </p>
                    <p class="t-line t-out t-grn">
                        ● running <span class="t-dim">env: development</span>
                    </p>
                    <p class="t-line t-sep t-dim">───────────────────────</p>
                    <p class="t-line t-prose">{p.pistation_dev.description}</p>
                    <p class="t-spacer"></p>
                    <span class="t-cta"
                        >{t.projects.visit}
                        <span aria-hidden="true">→</span></span
                    >
                </div>
            </a>

            <!-- ── Terminal: PiStation Prod ── -->
            <a
                href="https://prod.pistation.dev"
                target="_blank"
                rel="noopener noreferrer"
                class="project-card terminal-card"
            >
                <div class="terminal-header">
                    <div class="terminal-dots">
                        <span class="dot dot-red"></span>
                        <span class="dot dot-yellow"></span>
                        <span class="dot dot-green"></span>
                    </div>
                    <span class="terminal-bar-title">prod.pistation.dev</span>
                </div>
                <div class="terminal-body">
                    <p class="t-line">
                        <span class="t-prompt">$</span>
                        <span class="t-cmd">pistation status</span>
                    </p>
                    <p class="t-line t-out t-grn">
                        ● running <span class="t-dim">env: production</span>
                    </p>
                    <p class="t-line t-sep t-dim">───────────────────────</p>
                    <p class="t-line t-prose">{p.pistation_prod.description}</p>
                    <p class="t-spacer"></p>
                    <span class="t-cta"
                        >{t.projects.visit}
                        <span aria-hidden="true">→</span></span
                    >
                </div>
            </a>

        </div>

        <!-- ── Webs públicas (carousel) ── -->
        <Webs lang={lang} />

        <!-- ── App carousel (Swiper) ── -->
        <div class="app-swiper-wrap">
        <div class="swiper app-swiper">
            <div class="swiper-wrapper">

                <!-- ── App: Counters ── -->
                <div class="swiper-slide">
                    <a
                        href="https://play.google.com/store/apps/details?id=com.ikerlorente11.counters"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="project-card app-card"
                    >
                        <div class="app-info">
                            <div class="app-header">
                                <img src="/images/counters/logo_square_round.webp" alt="Counters" class="app-logo" width="52" height="52" loading="lazy" />
                                <div>
                                    <h3 class="app-name">{p.counters.title}</h3>
                                    <span class="app-platform">Android</span>
                                </div>
                            </div>
                            <p class="app-desc">{p.counters.description}</p>
                            <span class="ps-btn">{t.projects.download}</span>
                        </div>
                        <div class="app-mockup" aria-hidden="true">
                            <img src="/images/counters/Home_dark.webp" alt="" class="phone-img dark-img" loading="lazy" />
                            <img src="/images/counters/Home_light.webp" alt="" class="phone-img light-img" loading="lazy" />
                        </div>
                    </a>
                </div>

                <!-- ── App: Worca ── -->
                <div class="swiper-slide">
                    <a
                        href="https://play.google.com/store/apps/details?id=com.ikerlorente11.worca"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="project-card app-card"
                    >
                        <div class="app-info">
                            <div class="app-header">
                                <img src="/images/worca/logo_square_round.webp" alt="Worca" class="app-logo" width="52" height="52" loading="lazy" />
                                <div>
                                    <h3 class="app-name">{p.worca.title}</h3>
                                    <span class="app-platform">Android</span>
                                </div>
                            </div>
                            <p class="app-desc">{p.worca.description}</p>
                            <span class="ps-btn">{t.projects.download}</span>
                        </div>
                        <div class="app-mockup" aria-hidden="true">
                            <img src="/images/worca/Home_dark.webp" alt="" class="phone-img dark-img" loading="lazy" />
                            <img src="/images/worca/Home_light.webp" alt="" class="phone-img light-img" loading="lazy" />
                        </div>
                    </a>
                </div>

                <!-- ── App: RetoBox ── -->
                <div class="swiper-slide">
                    <a
                        href="https://play.google.com/store/apps/details?id=com.ikerlorente11.retobox"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="project-card app-card"
                    >
                        <div class="app-info">
                            <div class="app-header">
                                <img src="/images/retobox/logo_square_round.webp" alt="RetoBox" class="app-logo" width="52" height="52" loading="lazy" />
                                <div>
                                    <h3 class="app-name">{p.retobox.title}</h3>
                                    <span class="app-platform">Android</span>
                                </div>
                            </div>
                            <p class="app-desc">{p.retobox.description}</p>
                            <span class="ps-btn">{t.projects.download}</span>
                        </div>
                        <div class="app-mockup" aria-hidden="true">
                            <img src="/images/retobox/Home_dark.webp" alt="" class="phone-img dark-img" loading="lazy" />
                            <img src="/images/retobox/Home_light.webp" alt="" class="phone-img light-img" loading="lazy" />
                        </div>
                    </a>
                </div>

            </div>
            <div class="swiper-pagination app-pagination"></div>
        </div>
        <button class="app-prev app-nav-btn" aria-label="Previous">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="app-next app-nav-btn" aria-label="Next">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
        </div>
    </div>
</section>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    // CSS de Swiper estático: se agrupa en el bundle de la página (~4 KB) y
    // queda siempre disponible. Importarlo de forma diferida generaba chunks
    // CSS que Vite referenciaba pero no emitía (404) → el preload rechazaba la
    // promesa y Swiper nunca se inicializaba (solo se veía la 1ª tarjeta).
    import "swiper/swiper.css";
    import "swiper/css/navigation";
    import "swiper/css/pagination";
    gsap.registerPlugin(ScrollTrigger);

    // Section title
    gsap.from("#projects .section-title", {
        scrollTrigger: { trigger: "#projects", start: "top 85%" },
        y: 24,
        opacity: 0,
        duration: 0.6,
        ease: "power3.out",
    });

    // Cards stagger
    gsap.from(".project-card", {
        scrollTrigger: {
            trigger: "#projects .projects-grid",
            start: "top 80%",
        },
        y: 40,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: "power3.out",
        clearProps: "transform,opacity",
    });

    // ── App carousel (Swiper, carga diferida al acercarse la sección) ──
    const wrap = document.querySelector(".app-swiper-wrap") as HTMLElement;
    const rawSlides = document.querySelectorAll(".app-swiper .swiper-slide").length;

    function ppv() { return window.innerWidth >= 600 ? 2 : 1; }
    const needsScroll = rawSlides > ppv();

    async function initSwiper() {
        const [swiperMod, modulesMod] = await Promise.all([
            import("swiper"),
            import("swiper/modules"),
        ]);
        const Swiper = swiperMod.default;
        const { Navigation, Pagination, Autoplay } = modulesMod;

        new Swiper(".app-swiper", {
            modules: [Navigation, Pagination, Autoplay],
            loop: needsScroll,
            slidesPerView: 1,
            spaceBetween: 20,
            autoplay: needsScroll ? {
                delay: 4000,
                disableOnInteraction: false,
                pauseOnMouseEnter: true,
            } : false,
            navigation: {
                nextEl: ".app-next.app-nav-btn",
                prevEl: ".app-prev.app-nav-btn",
            },
            pagination: {
                el: ".app-pagination",
                clickable: true,
            },
            breakpoints: {
                600: { slidesPerView: 2 },
            },
        });
    }

    const swiperEl = document.querySelector(".app-swiper");
    if (swiperEl) {
        const io = new IntersectionObserver((entries) => {
            if (entries.some((e) => e.isIntersecting)) {
                io.disconnect();
                initSwiper();
            }
        }, { rootMargin: "600px" });
        io.observe(swiperEl);
    }

    function updateNav() {
        const hasMore = rawSlides > ppv();
        wrap.classList.toggle("has-nav", hasMore);
        wrap.classList.toggle("has-pagination", hasMore);
    }
    updateNav();
    window.addEventListener("resize", updateNav);

    // 3D tilt on hover
    document.querySelectorAll<HTMLElement>(".project-card").forEach((card) => {
        let raf = 0;
        card.addEventListener("mousemove", (e: MouseEvent) => {
            cancelAnimationFrame(raf);
            raf = requestAnimationFrame(() => {
                const r = card.getBoundingClientRect();
                const x = (e.clientX - r.left) / r.width - 0.5;
                const y = (e.clientY - r.top) / r.height - 0.5;
                card.style.transform = `perspective(700px) rotateX(${-y * 6}deg) rotateY(${x * 6}deg) translateY(-4px)`;
            });
        });
        card.addEventListener("mouseleave", () => {
            cancelAnimationFrame(raf);
            card.style.transition =
                "transform 0.4s ease, border-color 0.25s ease, box-shadow 0.25s ease";
            card.style.transform = "";
            setTimeout(() => {
                card.style.transition = "";
            }, 420);
        });
    });
</script>

<style>
    /* ── Grid (terminal cards) ───────────────────── */
    .projects-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
        margin-bottom: 1.25rem;
    }

    /* ── App carousel (Swiper) ───────────────────── */
    .app-swiper {
        width: 100%;
        overflow: hidden;
    }
    /* Layout previo a la carga diferida de Swiper: evita que los
       slides se apilen en vertical antes de que llegue su CSS */
    .app-swiper :global(.swiper-wrapper) {
        display: flex;
    }
    .app-swiper .swiper-slide {
        flex-shrink: 0;
        width: 100%;
    }
    .app-swiper-wrap.has-pagination .app-swiper {
        padding-bottom: 1.5rem !important;
    }
    :global(.app-pagination) {
        display: none !important;
    }
    .app-swiper-wrap.has-pagination :global(.app-pagination) {
        display: flex !important;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }

    .app-swiper .swiper-slide {
        height: auto;
    }

    .app-swiper .swiper-slide .app-card {
        height: 100%;
    }

    /* Pagination dots */
    .app-swiper {
        --swiper-pagination-bullet-horizontal-gap: 6px;
    }
    :global(.app-pagination .swiper-pagination-bullet) {
        margin: 0 !important;
    }
    .app-swiper :global(.swiper-pagination-bullet) {
        background: var(--border);
        opacity: 1;
        width: 8px;
        height: 8px;
        transition: background 0.2s, transform 0.2s;
    }
    .app-swiper :global(.swiper-pagination-bullet-active) {
        background: var(--accent);
        transform: scale(1.3);
    }

    /* Overlay nav buttons */
    .app-swiper-wrap {
        position: relative;
    }

    .app-nav-btn {
        display: none;
        position: absolute;
        top: calc(50% - 1.25rem);
        transform: translateY(-50%);
        z-index: 10;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid var(--border);
        background: var(--bg-elevated);
        color: var(--text-muted);
        cursor: pointer;
        align-items: center;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s, border-color 0.2s, color 0.2s, background 0.2s;
        backdrop-filter: blur(6px);
        box-shadow: 0 2px 12px rgba(0,0,0,0.4);
    }
    .app-prev { left: 0.5rem; }
    .app-next { right: 0.5rem; }

    /* Only show on desktop when wrap has .has-nav */
    @media (min-width: 769px) {
        .app-swiper-wrap.has-nav .app-nav-btn {
            display: inline-flex;
        }
        .app-swiper-wrap.has-nav:hover .app-nav-btn {
            opacity: 1;
            pointer-events: auto;
        }
        .app-nav-btn:hover {
            border-color: var(--accent);
            color: var(--accent-light);
            background: var(--accent-dim);
        }
    }

    /* ── Base card ───────────────────────────────── */
    .project-card {
        border-radius: var(--radius);
        border: 1px solid var(--border);
        overflow: hidden;
        text-decoration: none;
        color: var(--text);
        display: flex;
        flex-direction: column;
        transition:
            border-color 0.25s ease,
            box-shadow 0.25s ease,
            transform 0.1s ease;
        will-change: transform;
    }

    .project-card:hover {
        border-color: var(--border-hover);
        box-shadow: var(--shadow-glow);
        color: var(--text);
    }

    /* ── Terminal cards ──────────────────────────── */
    .terminal-card {
        background: #0d1117;
    }

    .terminal-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.65rem 1rem;
        background: #161b22;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        flex-shrink: 0;
    }

    .terminal-dots {
        display: flex;
        gap: 6px;
        flex-shrink: 0;
    }

    .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .dot-red {
        background: #ff5f57;
    }
    .dot-yellow {
        background: #febc2e;
    }
    .dot-green {
        background: #28c840;
    }

    .terminal-bar-title {
        font-size: 0.72rem;
        color: #6e7681;
        font-family: "Fira Code", "Courier New", monospace;
        flex: 1;
        text-align: center;
    }

    .terminal-body {
        padding: 1rem 1.2rem 1.2rem;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        flex: 1;
        font-family: "Fira Code", "Courier New", monospace;
    }

    .t-line {
        font-size: 0.78rem;
        line-height: 1.55;
    }
    .t-prompt {
        color: #a78bfa;
    }
    .t-cmd {
        color: #f0f6fc;
    }
    .t-grn {
        color: #22c55e;
    }
    .t-dim {
        color: #6e7681;
    }
    .t-out {
        padding-left: 1.1rem;
    }
    .t-sep {
        padding-left: 1.1rem;
        letter-spacing: 0.05em;
    }
    .t-prose {
        color: #c9d1d9;
        padding-left: 1.1rem;
        margin-top: 0.2rem;
        font-family: system-ui, sans-serif;
        font-size: 0.82rem;
        line-height: 1.55;
    }

    .t-spacer {
        flex: 1;
        min-height: 0.75rem;
    }

    .t-cta {
        display: inline-block;
        font-size: 0.78rem;
        color: var(--accent-2);
        font-family: "Fira Code", "Courier New", monospace;
        transition: letter-spacing 0.2s ease;
    }

    .terminal-card:hover .t-cta {
        letter-spacing: 0.05em;
    }

    /* ── App cards ───────────────────────────────── */
    .app-card {
        background: var(--bg-elevated);
        flex-direction: row;
        align-items: stretch;
        min-height: 220px;
    }

    .app-info {
        flex: 1;
        padding: 1.35rem;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        min-width: 0;
    }

    .app-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .app-logo {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        object-fit: cover;
        flex-shrink: 0;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
    }

    .app-name {
        font-family: "Space Grotesk", system-ui, sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.2;
    }

    .app-platform {
        font-size: 0.68rem;
        color: #4ade80;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .app-desc {
        font-size: 0.82rem;
        color: var(--text-muted);
        line-height: 1.55;
        flex: 1;
    }

    .ps-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: var(--accent-dim);
        border: 1px solid var(--border-hover);
        border-radius: 100px;
        padding: 0.35rem 0.9rem;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--accent-light);
        align-self: flex-start;
        transition: background 0.2s ease;
    }

    .app-card:hover .ps-btn {
        background: rgba(124, 58, 237, 0.25);
    }

    /* ── Phone mockup ────────────────────────────── */
    .app-mockup {
        width: 140px;
        flex-shrink: 0;
        overflow: hidden;
        padding: 12px 12px 12px 0;
        box-sizing: border-box;
    }

    .phone-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        display: block;
    }

    .light-img {
        display: none;
    }

    :global([data-theme="light"]) .light-img {
        display: block;
    }

    :global([data-theme="light"]) .dark-img {
        display: none;
    }

    /* ── Responsive ──────────────────────────────── */

    @media (max-width: 960px) {
        .projects-grid {
            grid-template-columns: 1fr;
        }
        .app-mockup {
            width: 160px;
        }
    }

    @media (max-width: 600px) {
        .app-card {
            flex-direction: column;
        }
        .app-mockup {
            width: 100%;
            height: 200px;
            display: flex;
            justify-content: center;
            padding: 0 20px 12px 20px;
            box-sizing: border-box;
        }
        .phone-img {
            width: auto;
            height: 100%;
            object-fit: initial;
        }
    }
</style>
