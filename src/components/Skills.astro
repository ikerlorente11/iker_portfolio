---
import type { Locale } from "../i18n/index";
import { getTranslations, skillsData } from "../i18n/index";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const cats = t.skills.categories;

const categories = [
    { key: "languages", label: cats.languages, skills: skillsData.languages, icon: "⟨/⟩" },
    { key: "frontend", label: cats.frontend, skills: skillsData.frontend, icon: "◻" },
    { key: "backend", label: cats.backend, skills: skillsData.backend, icon: "⚙" },
    { key: "databases", label: cats.databases, skills: skillsData.databases, icon: "⬡" },
    { key: "devops", label: cats.devops, skills: skillsData.devops, icon: "☁" },
    { key: "tools", label: cats.tools, skills: skillsData.tools, icon: "✦" },
];
---

<section id="skills">
    <div class="container">
        <h2 class="section-title reveal">{t.skills.title}</h2>

        <div class="skills-grid">
            {
                categories.map((cat, i) => (
                    <div
                        class="skill-category card reveal"
                        style={`transition-delay: ${i * 60}ms`}
                    >
                        <h3 class="cat-title">
                            <span class="cat-icon">{cat.icon}</span>
                            {cat.label}
                        </h3>
                        <ul class="skill-list">
                            {cat.skills.map((skill) => (
                                <li class="skill-item">
                                    <div class="skill-meta">
                                        <span class="skill-name">{skill.name}</span>
                                        <span class="skill-pct">{skill.level * 20}%</span>
                                    </div>
                                    <div class="skill-bar" aria-label={`${skill.name}: ${skill.level * 20}%`}>
                                        <div class="skill-fill" style={`--pct: ${skill.level * 20}%`}></div>
                                    </div>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(295px, 1fr));
        gap: 1.1rem;
    }

    .skill-category {
        padding: 1.25rem 1.4rem;
    }

    .cat-title {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent-light);
        margin-bottom: 1rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .cat-icon {
        color: var(--accent-2);
        font-size: 0.85rem;
        font-style: normal;
    }

    .skill-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .skill-item {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .skill-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .skill-name {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text);
    }

    .skill-pct {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--accent-light);
        opacity: 0.65;
    }

    .skill-bar {
        height: 5px;
        background: rgba(99, 102, 241, 0.08);
        border-radius: 3px;
        overflow: hidden;
        border: 1px solid var(--border);
    }

    .skill-fill {
        height: 100%;
        width: 0;
        background: linear-gradient(90deg, var(--accent), var(--accent-light), var(--accent-2));
        border-radius: 3px;
        transition: width 0.9s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 0 6px var(--accent-glow);
    }

    /* Trigger animation when card becomes visible via IntersectionObserver */
    .skill-category.visible .skill-fill {
        width: var(--pct);
    }

    @media (max-width: 640px) {
        .skills-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
