---
import type { Locale } from "../i18n/index";
import { getTranslations, getExperienceData } from "../i18n/index";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const entries = getExperienceData(lang);
---

<section id="experience">
    <div class="container">
        <h2 class="section-title reveal">{t.experience.title}</h2>

        <div class="timeline">
            {
                entries.map((entry, i) => (
                    <div
                        class="timeline-item reveal"
                        style={`transition-delay: ${i * 60}ms`}
                    >
                        <div class="timeline-dot" />
                        <div class="timeline-content card">
                            <div class="exp-header">
                                <div class="exp-header-left">
                                    <span class="exp-company">{entry.company}</span>
                                    {i === 0 && (
                                        <span class="badge-current">
                                            <span class="badge-dot"></span>
                                            {t.experience.present}
                                        </span>
                                    )}
                                </div>
                                <span class="exp-period">{entry.period}</span>
                            </div>
                            <p class="exp-role">{entry.role}</p>
                            <div class="exp-techs">
                                {entry.techs.map((tech) => (
                                    <span class="tech-tag">{tech}</span>
                                ))}
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    @keyframes pulse-dot {
        0%, 100% { box-shadow: 0 0 0 3px var(--accent-dim), 0 0 10px rgba(99,102,241,0.3); }
        50% { box-shadow: 0 0 0 7px rgba(99,102,241,0.08), 0 0 22px rgba(99,102,241,0.5); }
    }

    @keyframes pulse-badge-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(0.75); }
    }

    .timeline {
        position: relative;
        padding-left: 2rem;
    }

    .timeline::before {
        content: "";
        position: absolute;
        left: 7px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(to bottom, var(--accent), var(--accent-2), transparent);
    }

    .timeline-item {
        position: relative;
        margin-bottom: 1rem;
    }

    .timeline-item:last-child {
        margin-bottom: 0;
    }

    .timeline-dot {
        position: absolute;
        left: -2rem;
        top: 1.25rem;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        border: 2px solid var(--bg);
        box-shadow: 0 0 0 3px var(--accent-dim), 0 0 10px rgba(99,102,241,0.3);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        z-index: 1;
    }

    .timeline-item:first-child .timeline-dot {
        animation: pulse-dot 2.2s ease-in-out infinite;
    }

    .timeline-item:hover .timeline-dot {
        transform: scale(1.3);
        box-shadow: 0 0 0 4px var(--accent-dim), 0 0 18px rgba(99,102,241,0.5);
    }

    .timeline-content {
        padding: 0.9rem 1.1rem;
        border-left: 2px solid transparent;
        transition: border-color 0.25s ease;
    }

    .timeline-item:first-child .timeline-content {
        border-left-color: var(--accent);
    }

    .timeline-item:hover .timeline-content {
        border-left-color: var(--accent);
    }

    .exp-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.4rem 1rem;
        margin-bottom: 0.4rem;
    }

    .exp-header-left {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

    .exp-company {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
    }

    .badge-current {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: rgba(34, 197, 94, 0.1);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.25);
        border-radius: 20px;
        padding: 0.15rem 0.65rem;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #4ade80;
        animation: pulse-badge-dot 1.5s ease-in-out infinite;
        flex-shrink: 0;
    }

    .exp-period {
        font-size: 0.78rem;
        color: var(--accent-light);
        font-weight: 600;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    .exp-role {
        font-size: 0.875rem;
        color: var(--text-muted);
        margin-bottom: 0.55rem;
        font-style: italic;
    }

    .exp-techs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    @media (max-width: 640px) {
        .timeline {
            padding-left: 1.5rem;
        }

        .timeline-dot {
            left: -1.5rem;
            top: 1.1rem;
        }

        .exp-header {
            flex-direction: column;
        }
    }
</style>
