---
import type { Locale } from "../i18n/index";
import { getTranslations, getExperienceData } from "../i18n/index";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const entries = getExperienceData(lang);
---

<section id="experience">
    <div class="container">
        <h2 class="section-title reveal">{t.experience.title}</h2>

        <div class="timeline">
            {
                entries.map((entry, i) => (
                    <div
                        class="timeline-item reveal"
                        style={`transition-delay: ${i * 60}ms`}
                    >
                        <div class="timeline-dot" />
                        <div class="timeline-content card">
                            <div class="exp-header">
                                <span class="exp-period">{entry.period}</span>
                                <span class="exp-company">{entry.company}</span>
                            </div>
                            <p class="exp-role">{entry.role}</p>
                            <div class="exp-techs">
                                {entry.techs.map((tech) => (
                                    <span class="tech-tag">{tech}</span>
                                ))}
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .timeline {
        position: relative;
        padding-left: 2rem;
    }

    .timeline::before {
        content: "";
        position: absolute;
        left: 7px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(to bottom, var(--accent), transparent);
    }

    .timeline-item {
        position: relative;
        margin-bottom: 1rem;
    }

    .timeline-item:last-child {
        margin-bottom: 0;
    }

    .timeline-dot {
        position: absolute;
        left: -2rem;
        top: 1.25rem;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--accent);
        border: 2px solid var(--bg);
        box-shadow: 0 0 0 3px var(--accent-dim);
        transition: transform 0.2s ease;
    }

    .timeline-item:hover .timeline-dot {
        transform: scale(1.25);
    }

    .timeline-content {
        padding: 0.85rem 1.1rem;
    }

    .exp-header {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
        margin-bottom: 0.35rem;
    }

    .exp-period {
        font-size: 0.8rem;
        color: var(--accent-light);
        font-weight: 600;
        letter-spacing: 0.04em;
    }

    .exp-company {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
    }

    .exp-role {
        font-size: 0.875rem;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
    }

    .exp-techs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    @media (max-width: 640px) {
        .timeline {
            padding-left: 1.5rem;
        }

        .timeline-dot {
            left: -1.5rem;
            top: 1.1rem;
        }
    }
</style>
