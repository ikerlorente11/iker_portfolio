---
import type { Locale } from "../i18n/index";
import { getTranslations, getExperienceData } from "../i18n/index";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const entries = getExperienceData(lang);
---

<section id="experience">
    <div class="container">
        <h2 class="section-title">{t.experience.title}</h2>

        <div class="timeline" id="exp-timeline">
            {
                entries.map((entry, i) => (
                    <div class="timeline-item" data-index={i}>
                        <div class="timeline-connector">
                            <div class="timeline-dot" />
                        </div>
                        <div class="timeline-content card">
                            <div class="exp-header">
                                <div class="exp-header-left">
                                    <span class="exp-company">
                                        {entry.company}
                                    </span>
                                    {i === 0 && (
                                        <span class="badge-current">
                                            <span class="badge-dot" />
                                            {t.experience.present}
                                        </span>
                                    )}
                                </div>
                                <span class="exp-period">{entry.period}</span>
                            </div>
                            <p class="exp-role">{entry.role}</p>
                            <div class="exp-techs">
                                {entry.techs.map((tech) => (
                                    <span class="tech-tag">{tech}</span>
                                ))}
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    // Title
    gsap.from("#experience .section-title", {
        scrollTrigger: { trigger: "#experience", start: "top 85%" },
        y: 24,
        opacity: 0,
        duration: 0.6,
        ease: "power3.out",
    });

    // Timeline line draw
    gsap.from("#exp-timeline::before", {
        scrollTrigger: {
            trigger: "#exp-timeline",
            start: "top 80%",
            end: "bottom 20%",
            scrub: 1,
        },
        scaleY: 0,
        transformOrigin: "top center",
        ease: "none",
    });

    // Items stagger from alternating sides
    const items = document.querySelectorAll(".timeline-item");
    items.forEach((item, i) => {
        gsap.from(item, {
            scrollTrigger: { trigger: item, start: "top 85%", once: true },
            x: -40,
            opacity: 0,
            duration: 0.6,
            delay: 0.05,
            ease: "power3.out",
        });
    });
</script>

<style>
    @keyframes pulse-dot {
        0%,
        100% {
            box-shadow:
                0 0 0 3px var(--accent-dim),
                0 0 10px rgba(124, 58, 237, 0.3);
        }
        50% {
            box-shadow:
                0 0 0 8px rgba(124, 58, 237, 0.06),
                0 0 22px rgba(124, 58, 237, 0.45);
        }
    }

    @keyframes pulse-badge-dot {
        0%,
        100% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            opacity: 0.4;
            transform: scale(0.7);
        }
    }

    /* ── Vertical line ───────────────────────────────── */
    .timeline {
        position: relative;
        padding-left: 2.25rem;
    }

    .timeline::before {
        content: "";
        position: absolute;
        left: 8px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(
            to bottom,
            var(--accent),
            var(--accent-2),
            transparent
        );
        border-radius: 2px;
    }

    /* ── Items ───────────────────────────────────────── */
    .timeline-item {
        position: relative;
        margin-bottom: 1.1rem;
    }

    .timeline-item:last-child {
        margin-bottom: 0;
    }

    .timeline-connector {
        position: absolute;
        left: -2.25rem;
        top: 1.1rem;
    }

    .timeline-dot {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        border: 2px solid var(--bg);
        box-shadow: 0 0 0 3px var(--accent-dim);
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .timeline-item:first-child .timeline-dot {
        animation: pulse-dot 2.2s ease-in-out infinite;
    }

    .timeline-item:hover .timeline-dot {
        transform: scale(1.25);
        box-shadow:
            0 0 0 4px var(--accent-dim),
            0 0 16px rgba(124, 58, 237, 0.45);
    }

    /* ── Content card ────────────────────────────────── */
    .timeline-content {
        padding: 1rem 1.25rem;
        border-left: 2px solid transparent;
        transition: border-color 0.25s ease;
    }

    .timeline-item:first-child .timeline-content {
        border-left-color: var(--accent);
    }

    .timeline-item:hover .timeline-content {
        border-left-color: var(--accent);
    }

    /* ── Header ──────────────────────────────────────── */
    .exp-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.4rem 1rem;
        margin-bottom: 0.4rem;
    }

    .exp-header-left {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

    .exp-company {
        font-family: "Space Grotesk", system-ui, sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
    }

    .badge-current {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: rgba(34, 197, 94, 0.1);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.25);
        border-radius: 100px;
        padding: 0.15rem 0.65rem;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #4ade80;
        animation: pulse-badge-dot 1.5s ease-in-out infinite;
        flex-shrink: 0;
    }

    .exp-period {
        font-size: 0.78rem;
        color: var(--accent-light);
        font-weight: 600;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    .exp-role {
        font-size: 0.875rem;
        color: var(--text-muted);
        margin-bottom: 0.65rem;
        font-style: italic;
    }

    .exp-techs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    @media (max-width: 640px) {
        .timeline {
            padding-left: 1.75rem;
        }
        .timeline-connector {
            left: -1.75rem;
        }
        .exp-header {
            flex-direction: column;
        }
    }
</style>
