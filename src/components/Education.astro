---
import type { Locale } from "../i18n/index";
import { getTranslations, getEducationData } from "../i18n/index";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const entries = getEducationData(lang);
---

<section id="education">
    <div class="container">
        <h2 class="section-title reveal">{t.education.title}</h2>

        <div class="edu-list">
            {
                entries.map((entry, i) => (
                    <div
                        class="edu-item card reveal"
                        style={`transition-delay: ${i * 80}ms`}
                    >
                        <div class="edu-header">
                            <span class="edu-period">{entry.period}</span>
                            <svg
                                class="edu-icon"
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <>
                                    <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                                    <path d="M6 12v5c3 3 9 3 12 0v-5" />
                                </>
                            </svg>
                        </div>
                        <h3 class="edu-title">{entry.title}</h3>
                        {entry.achievements.length > 0 && (
                            <div class="edu-achievements">
                                <span class="achievements-label">
                                    {t.education.achievements}
                                </span>
                                <ul>
                                    {entry.achievements.map((a) => (
                                        <li>{a}</li>
                                    ))}
                                </ul>
                            </div>
                        )}
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .edu-list {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
    }

    .edu-item {
        padding: 1rem 1.25rem;
        border-left: 3px solid var(--accent);
        transition: border-color 0.25s ease;
    }

    .edu-item:hover {
        border-left-color: var(--accent-light);
    }

    .edu-item:nth-child(2) {
        border-left-color: #8b5cf6;
    }

    .edu-item:nth-child(2):hover {
        border-left-color: #a78bfa;
    }

    .edu-item:nth-child(3) {
        border-left-color: var(--accent-2);
    }

    .edu-item:nth-child(3):hover {
        border-left-color: #22d3ee;
    }

    .edu-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.5rem;
    }

    .edu-period {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--accent-light);
        letter-spacing: 0.04em;
    }

    .edu-icon {
        color: var(--accent-light);
        opacity: 0.5;
    }

    .edu-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text);
        line-height: 1.4;
    }

    .edu-achievements {
        margin-top: 0.75rem;
    }

    .achievements-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--accent-light);
        display: block;
        margin-bottom: 0.35rem;
    }

    .edu-achievements ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.28rem;
    }

    .edu-achievements li {
        font-size: 0.875rem;
        color: var(--text-muted);
        padding-left: 1rem;
        position: relative;
    }

    .edu-achievements li::before {
        content: "▸";
        position: absolute;
        left: 0;
        color: var(--accent-2);
        font-size: 0.7rem;
        top: 0.1em;
    }
</style>
