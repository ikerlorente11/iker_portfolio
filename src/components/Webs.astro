---
import type { Locale } from "../i18n/index";
import { getTranslations } from "../i18n/index";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const w = t.webs;

// Webs públicas desplegadas en PiStation. Los textos viven en i18n (t.webs);
// aquí solo lo que no se traduce: URL, logo y stack.
const sites = [
    {
        key: "soundlift",
        host: "soundlift.pistation.dev",
        logo: "/images/soundlift/logo.svg",
        stack: "Node.js · Docker",
        text: w.soundlift,
    },
    {
        key: "retobox",
        host: "retobox.pistation.dev",
        logo: "/images/retobox/logo_square_round.webp",
        stack: "React · FastAPI",
        text: w.retobox,
    },
    {
        key: "f1",
        host: "f1.pistation.dev",
        logo: "/images/f1/logo.png",
        stack: "Rust · Next.js",
        text: w.f1,
    },
] as const;
---

<section id="webs">
    <div class="container">
        <h2 class="section-title">{w.title}</h2>

        <div class="webs-grid">
            {
                sites.map((site) => (
                    <a
                        href={`https://${site.host}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="web-card"
                    >
                        <!-- Barra de navegador: puntos + URL -->
                        <div class="browser-bar">
                            <div class="browser-dots" aria-hidden="true">
                                <span class="dot dot-red" />
                                <span class="dot dot-yellow" />
                                <span class="dot dot-green" />
                            </div>
                            <span class="url-pill">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="10"
                                    height="10"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <rect x="3" y="11" width="18" height="11" rx="2" />
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                </svg>
                                {site.host}
                            </span>
                        </div>

                        <div class="web-body">
                            <div class="web-header">
                                <img
                                    src={site.logo}
                                    alt={site.text.title}
                                    class="web-logo"
                                    width="52"
                                    height="52"
                                    loading="lazy"
                                />
                                <div>
                                    <h3 class="web-name">{site.text.title}</h3>
                                    <span class="web-stack">{site.stack}</span>
                                </div>
                            </div>
                            <p class="web-desc">{site.text.description}</p>
                            <span class="web-cta">
                                {w.visit} <span aria-hidden="true">→</span>
                            </span>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</section>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    // Section title
    gsap.from("#webs .section-title", {
        scrollTrigger: { trigger: "#webs", start: "top 85%" },
        y: 24,
        opacity: 0,
        duration: 0.6,
        ease: "power3.out",
    });

    // Cards stagger
    gsap.from(".web-card", {
        scrollTrigger: {
            trigger: "#webs .webs-grid",
            start: "top 80%",
        },
        y: 40,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: "power3.out",
        clearProps: "transform,opacity",
    });

    // 3D tilt on hover (mismo efecto que las tarjetas de Projects)
    document.querySelectorAll<HTMLElement>(".web-card").forEach((card) => {
        let raf = 0;
        card.addEventListener("mousemove", (e: MouseEvent) => {
            cancelAnimationFrame(raf);
            raf = requestAnimationFrame(() => {
                const r = card.getBoundingClientRect();
                const x = (e.clientX - r.left) / r.width - 0.5;
                const y = (e.clientY - r.top) / r.height - 0.5;
                card.style.transform = `perspective(700px) rotateX(${-y * 6}deg) rotateY(${x * 6}deg) translateY(-4px)`;
            });
        });
        card.addEventListener("mouseleave", () => {
            cancelAnimationFrame(raf);
            card.style.transition =
                "transform 0.4s ease, border-color 0.25s ease, box-shadow 0.25s ease";
            card.style.transform = "";
            setTimeout(() => {
                card.style.transition = "";
            }, 420);
        });
    });
</script>

<style>
    .webs-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
    }

    /* ── Card ────────────────────────────────────── */
    .web-card {
        border-radius: var(--radius);
        border: 1px solid var(--border);
        background: var(--bg-elevated);
        overflow: hidden;
        text-decoration: none;
        color: var(--text);
        display: flex;
        flex-direction: column;
        transition:
            border-color 0.25s ease,
            box-shadow 0.25s ease,
            transform 0.1s ease;
        will-change: transform;
    }

    .web-card:hover {
        border-color: var(--border-hover);
        box-shadow: var(--shadow-glow);
        color: var(--text);
    }

    /* ── Browser bar ─────────────────────────────── */
    .browser-bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.9rem;
        background: #161b22;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        flex-shrink: 0;
    }

    .browser-dots {
        display: flex;
        gap: 6px;
        flex-shrink: 0;
    }

    .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
    }
    .dot-red {
        background: #ff5f57;
    }
    .dot-yellow {
        background: #febc2e;
    }
    .dot-green {
        background: #28c840;
    }

    .url-pill {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        min-width: 0;
        padding: 0.25rem 0.75rem;
        border-radius: var(--radius-sm);
        background: #0d1117;
        color: #8b949e;
        font-family: "Fira Code", "Courier New", monospace;
        font-size: 0.7rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .url-pill svg {
        flex-shrink: 0;
        color: #28c840;
    }

    /* ── Body ────────────────────────────────────── */
    .web-body {
        flex: 1;
        padding: 1.35rem;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        min-width: 0;
    }

    .web-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .web-logo {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        object-fit: cover;
        flex-shrink: 0;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
    }

    .web-name {
        font-family: "Space Grotesk", system-ui, sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.2;
    }

    .web-stack {
        font-size: 0.68rem;
        color: var(--accent-2);
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .web-desc {
        font-size: 0.82rem;
        color: var(--text-muted);
        line-height: 1.55;
        flex: 1;
    }

    .web-cta {
        display: inline-block;
        align-self: flex-start;
        font-size: 0.78rem;
        color: var(--accent-2);
        font-family: "Fira Code", "Courier New", monospace;
        transition: letter-spacing 0.2s ease;
    }

    .web-card:hover .web-cta {
        letter-spacing: 0.05em;
    }

    /* ── Responsive ──────────────────────────────── */
    @media (max-width: 960px) {
        .webs-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 600px) {
        .webs-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
