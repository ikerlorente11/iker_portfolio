---
import type { Locale } from "../i18n/index";
import { getTranslations } from "../i18n/index";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const w = t.webs;

// Webs públicas desplegadas en PiStation. Se renderiza dentro de la sección
// Projects, entre las tarjetas de servidores y el carousel de apps.
// Los textos viven en i18n (t.webs); aquí solo lo que no se traduce.
// Las tres webs son solo tema oscuro: una única captura por web.
const sites = [
    {
        key: "soundlift",
        host: "soundlift.pistation.dev",
        logo: "/images/soundlift/logo.svg",
        screenshot: "/images/soundlift/screenshot.webp",
        stack: "Node.js · Docker",
        text: w.soundlift,
    },
    {
        key: "retobox",
        host: "retobox.pistation.dev",
        logo: "/images/retobox/logo_square_round.webp",
        screenshot: "/images/retobox/screenshot.webp",
        stack: "React · FastAPI",
        text: w.retobox,
    },
    {
        key: "f1",
        host: "f1.pistation.dev",
        logo: "/images/f1/logo.png",
        screenshot: "/images/f1/screenshot.webp",
        stack: "Rust · Next.js",
        text: w.f1,
    },
] as const;
---

<!-- ── Web carousel (Swiper) ── -->
<div class="web-swiper-wrap" id="webs">
    <div class="swiper web-swiper">
        <div class="swiper-wrapper">
            {
                sites.map((site) => (
                    <div class="swiper-slide">
                        <a
                            href={`https://${site.host}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="web-card"
                        >
                            <!-- Barra de navegador: puntos + URL -->
                            <div class="browser-bar">
                                <div class="browser-dots" aria-hidden="true">
                                    <span class="dot dot-red" />
                                    <span class="dot dot-yellow" />
                                    <span class="dot dot-green" />
                                </div>
                                <span class="url-pill">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="10"
                                        height="10"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        aria-hidden="true"
                                    >
                                        <rect x="3" y="11" width="18" height="11" rx="2" />
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                    </svg>
                                    {site.host}
                                </span>
                            </div>

                            <!-- Captura de la web (1440×900 → 1200 px, WebP) -->
                            <div class="web-shot">
                                <img
                                    src={site.screenshot}
                                    alt={`${site.text.title} — ${site.host}`}
                                    width="1200"
                                    height="750"
                                    loading="lazy"
                                    decoding="async"
                                />
                            </div>

                            <div class="web-body">
                                <div class="web-header">
                                    <img
                                        src={site.logo}
                                        alt={site.text.title}
                                        class="web-logo"
                                        width="52"
                                        height="52"
                                        loading="lazy"
                                    />
                                    <div>
                                        <h3 class="web-name">{site.text.title}</h3>
                                        <span class="web-stack">{site.stack}</span>
                                    </div>
                                </div>
                                <p class="web-desc">{site.text.description}</p>
                                <span class="web-cta">
                                    {w.visit} <span aria-hidden="true">→</span>
                                </span>
                            </div>
                        </a>
                    </div>
                ))
            }
        </div>
        <div class="swiper-pagination web-pagination"></div>
    </div>
    <button class="web-prev web-nav-btn" aria-label="Previous">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="web-next web-nav-btn" aria-label="Next">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
</div>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import "swiper/swiper.css";
    import "swiper/css/navigation";
    import "swiper/css/pagination";
    gsap.registerPlugin(ScrollTrigger);

    // Cards stagger
    gsap.from(".web-card", {
        scrollTrigger: {
            trigger: ".web-swiper-wrap",
            start: "top 80%",
        },
        y: 40,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: "power3.out",
        clearProps: "transform,opacity",
    });

    // ── Web carousel (Swiper, carga diferida al acercarse; mismo patrón que apps) ──
    const wrap = document.querySelector(".web-swiper-wrap") as HTMLElement;
    const rawSlides = document.querySelectorAll(".web-swiper .swiper-slide").length;

    function ppv() { return window.innerWidth >= 769 ? 2 : 1; }
    const needsScroll = rawSlides > ppv();

    async function initSwiper() {
        const [swiperMod, modulesMod] = await Promise.all([
            import("swiper"),
            import("swiper/modules"),
        ]);
        const Swiper = swiperMod.default;
        const { Navigation, Pagination, Autoplay } = modulesMod;

        new Swiper(".web-swiper", {
            modules: [Navigation, Pagination, Autoplay],
            loop: needsScroll,
            slidesPerView: 1,
            spaceBetween: 20,
            autoplay: needsScroll ? {
                delay: 5000,
                disableOnInteraction: false,
                pauseOnMouseEnter: true,
            } : false,
            navigation: {
                nextEl: ".web-next.web-nav-btn",
                prevEl: ".web-prev.web-nav-btn",
            },
            pagination: {
                el: ".web-pagination",
                clickable: true,
            },
            breakpoints: {
                769: { slidesPerView: 2 },
            },
        });
    }

    const swiperEl = document.querySelector(".web-swiper");
    if (swiperEl) {
        const io = new IntersectionObserver((entries) => {
            if (entries.some((e) => e.isIntersecting)) {
                io.disconnect();
                initSwiper();
            }
        }, { rootMargin: "600px" });
        io.observe(swiperEl);
    }

    function updateNav() {
        const hasMore = rawSlides > ppv();
        wrap.classList.toggle("has-nav", hasMore);
        wrap.classList.toggle("has-pagination", hasMore);
    }
    updateNav();
    window.addEventListener("resize", updateNav);

    // 3D tilt on hover (mismo efecto que las tarjetas de Projects)
    document.querySelectorAll<HTMLElement>(".web-card").forEach((card) => {
        let raf = 0;
        card.addEventListener("mousemove", (e: MouseEvent) => {
            cancelAnimationFrame(raf);
            raf = requestAnimationFrame(() => {
                const r = card.getBoundingClientRect();
                const x = (e.clientX - r.left) / r.width - 0.5;
                const y = (e.clientY - r.top) / r.height - 0.5;
                card.style.transform = `perspective(700px) rotateX(${-y * 6}deg) rotateY(${x * 6}deg) translateY(-4px)`;
            });
        });
        card.addEventListener("mouseleave", () => {
            cancelAnimationFrame(raf);
            card.style.transition =
                "transform 0.4s ease, border-color 0.25s ease, box-shadow 0.25s ease";
            card.style.transform = "";
            setTimeout(() => {
                card.style.transition = "";
            }, 420);
        });
    });
</script>

<style>
    /* ── Carousel (mismos estilos que el de apps en Projects) ── */
    .web-swiper-wrap {
        position: relative;
        margin-bottom: 1.25rem;
    }
    .web-swiper {
        width: 100%;
        overflow: hidden;
    }
    /* Layout previo a la carga diferida de Swiper: evita que los
       slides se apilen en vertical antes de que llegue su CSS */
    .web-swiper :global(.swiper-wrapper) {
        display: flex;
    }
    .web-swiper .swiper-slide {
        flex-shrink: 0;
        width: 100%;
        height: auto;
    }
    .web-swiper .swiper-slide .web-card {
        height: 100%;
    }
    .web-swiper-wrap.has-pagination .web-swiper {
        padding-bottom: 1.5rem !important;
    }
    :global(.web-pagination) {
        display: none !important;
    }
    .web-swiper-wrap.has-pagination :global(.web-pagination) {
        display: flex !important;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }

    /* Pagination dots */
    .web-swiper {
        --swiper-pagination-bullet-horizontal-gap: 6px;
    }
    :global(.web-pagination .swiper-pagination-bullet) {
        margin: 0 !important;
    }
    .web-swiper :global(.swiper-pagination-bullet) {
        background: var(--border);
        opacity: 1;
        width: 8px;
        height: 8px;
        transition: background 0.2s, transform 0.2s;
    }
    .web-swiper :global(.swiper-pagination-bullet-active) {
        background: var(--accent);
        transform: scale(1.3);
    }

    /* Overlay nav buttons */
    .web-nav-btn {
        display: none;
        position: absolute;
        top: calc(50% - 1.25rem);
        transform: translateY(-50%);
        z-index: 10;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid var(--border);
        background: var(--bg-elevated);
        color: var(--text-muted);
        cursor: pointer;
        align-items: center;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s, border-color 0.2s, color 0.2s, background 0.2s;
        backdrop-filter: blur(6px);
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
    }
    .web-prev { left: 0.5rem; }
    .web-next { right: 0.5rem; }

    @media (min-width: 769px) {
        .web-swiper-wrap.has-nav .web-nav-btn {
            display: inline-flex;
        }
        .web-swiper-wrap.has-nav:hover .web-nav-btn {
            opacity: 1;
            pointer-events: auto;
        }
        .web-nav-btn:hover {
            border-color: var(--accent);
            color: var(--accent-light);
            background: var(--accent-dim);
        }
    }

    /* ── Card ────────────────────────────────────── */
    .web-card {
        border-radius: var(--radius);
        border: 1px solid var(--border);
        background: var(--bg-elevated);
        overflow: hidden;
        text-decoration: none;
        color: var(--text);
        display: flex;
        flex-direction: column;
        transition:
            border-color 0.25s ease,
            box-shadow 0.25s ease,
            transform 0.1s ease;
        will-change: transform;
    }

    .web-card:hover {
        border-color: var(--border-hover);
        box-shadow: var(--shadow-glow);
        color: var(--text);
    }

    /* ── Browser bar ─────────────────────────────── */
    .browser-bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.9rem;
        background: #161b22;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        flex-shrink: 0;
    }

    .browser-dots {
        display: flex;
        gap: 6px;
        flex-shrink: 0;
    }

    .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
    }
    .dot-red {
        background: #ff5f57;
    }
    .dot-yellow {
        background: #febc2e;
    }
    .dot-green {
        background: #28c840;
    }

    .url-pill {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        min-width: 0;
        padding: 0.25rem 0.75rem;
        border-radius: var(--radius-sm);
        background: #0d1117;
        color: #8b949e;
        font-family: "Fira Code", "Courier New", monospace;
        font-size: 0.7rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .url-pill svg {
        flex-shrink: 0;
        color: #28c840;
    }

    /* ── Screenshot ──────────────────────────────── */
    .web-shot {
        aspect-ratio: 16 / 10;
        overflow: hidden;
        background: #0d1117;
        border-bottom: 1px solid var(--border);
    }
    .web-shot img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        display: block;
        transition: transform 0.5s ease;
    }
    .web-card:hover .web-shot img {
        transform: scale(1.03);
    }

    /* ── Body ────────────────────────────────────── */
    .web-body {
        flex: 1;
        padding: 1.35rem;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        min-width: 0;
    }

    .web-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .web-logo {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        object-fit: cover;
        flex-shrink: 0;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
    }

    .web-name {
        font-family: "Space Grotesk", system-ui, sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.2;
    }

    .web-stack {
        font-size: 0.68rem;
        color: var(--accent-2);
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .web-desc {
        font-size: 0.82rem;
        color: var(--text-muted);
        line-height: 1.55;
        flex: 1;
    }

    .web-cta {
        display: inline-block;
        align-self: flex-start;
        font-size: 0.78rem;
        color: var(--accent-2);
        font-family: "Fira Code", "Courier New", monospace;
        transition: letter-spacing 0.2s ease;
    }

    .web-card:hover .web-cta {
        letter-spacing: 0.05em;
    }
</style>
