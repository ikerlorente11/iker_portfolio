---
import type { Locale } from "../i18n/index";
import { getTranslations } from "../i18n/index";
import CVDownload from "./CVDownload.astro";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<nav class="nav" id="nav">
    <div class="nav-pill">
        <a href={`/${lang}`} class="nav-logo">
            <img src="/favicon.png?v=2" alt="ILC" class="nav-logo-img" />
        </a>

        <ul class="nav-links" id="nav-links">
            <li><a href={`/${lang}#skills`}>{t.nav.skills}</a></li>
            <li><a href={`/${lang}#experience`}>{t.nav.experience}</a></li>
            <li><a href={`/${lang}#education`}>{t.nav.education}</a></li>
            <li><a href={`/${lang}#projects`}>{t.nav.projects}</a></li>
        </ul>

        <div class="nav-controls">
            <CVDownload lang={lang} />

            <div class="lang-switcher">
                <a
                    href="/es"
                    class:list={["lang-btn", { active: lang === "es" }]}
                    onclick="localStorage.setItem('lang-preference','es')">ES</a
                >
                <span class="lang-sep">|</span>
                <a
                    href="/en"
                    class:list={["lang-btn", { active: lang === "en" }]}
                    onclick="localStorage.setItem('lang-preference','en')">EN</a
                >
                <span class="lang-sep">|</span>
                <a
                    href="/eu"
                    class:list={["lang-btn", { active: lang === "eu" }]}
                    onclick="localStorage.setItem('lang-preference','eu')">EU</a
                >
            </div>

            <button
                class="theme-toggle"
                id="theme-toggle"
                aria-label="Toggle theme"
            >
                <svg
                    class="icon-sun"
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
                <svg
                    class="icon-moon"
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                    ></path>
                </svg>
            </button>
        </div>

        <button
            class="nav-hamburger"
            id="nav-hamburger"
            aria-label="Toggle menu"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</nav>

<script is:inline>
    // Theme toggle
    const toggleBtn = document.getElementById("theme-toggle");
    function applyTheme(theme) {
        document.documentElement.setAttribute("data-theme", theme);
        localStorage.setItem("theme", theme);
    }
    if (toggleBtn) {
        toggleBtn.addEventListener("click", function () {
            const current = document.documentElement.getAttribute("data-theme");
            applyTheme(current === "dark" ? "light" : "dark");
        });
    }

    // Mobile hamburger
    const hamburger = document.getElementById("nav-hamburger");
    const navLinks = document.getElementById("nav-links");
    if (hamburger && navLinks) {
        hamburger.addEventListener("click", function () {
            navLinks.classList.toggle("open");
            hamburger.classList.toggle("open");
        });
        // Close on link click
        navLinks.querySelectorAll("a").forEach(function (a) {
            a.addEventListener("click", function () {
                navLinks.classList.remove("open");
                hamburger.classList.remove("open");
            });
        });
    }

    // Scroll shrink
    window.addEventListener("scroll", function () {
        const nav = document.getElementById("nav");
        if (nav) nav.classList.toggle("scrolled", window.scrollY > 40);
    });
</script>

<style>
    /* ── Nav wrapper ─ fills viewport width, pointer-events off so bg is clickable ── */
    .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        display: flex;
        justify-content: center;
        padding: 1.25rem 1rem 0;
        pointer-events: none;
        border-bottom: 1px solid transparent;
        transition:
            padding 0.3s ease,
            background 0.3s ease,
            border-color 0.3s ease;
    }

    /* Scrolled: barra sólida pegada al top, sin gap ni hueco visible */
    .nav.scrolled {
        padding: 0 1rem;
        background: var(--nav-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom-color: var(--border);
        pointer-events: auto;
    }

    /* ── Floating pill ─────────────────────────────────── */
    .nav-pill {
        pointer-events: auto;
        position: relative;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 0.55rem 1.35rem;
        border-radius: 100px;
        background: var(--nav-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
        transition:
            background 0.3s ease,
            border-color 0.3s ease,
            box-shadow 0.3s ease,
            border-radius 0.3s ease,
            backdrop-filter 0.3s ease;
        max-width: 860px;
        width: 100%;
    }

    /* Al hacer scroll, la píldora se vuelve transparente (el nav ya hace de fondo) */
    .nav.scrolled .nav-pill {
        background: transparent;
        border-color: transparent;
        box-shadow: none;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        border-radius: 0;
    }

    /* Light mode nav overrides via :global() to bypass Astro scoping */
    :global([data-theme="light"]) .nav-links a:hover {
        background: rgba(0, 0, 0, 0.06);
        color: var(--text);
    }

    /* ── Logo ──────────────────────────────────────────── */
    .nav-logo {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        transition: opacity 0.2s ease;
    }

    .nav-logo:hover {
        opacity: 0.75;
    }

    .nav-logo-img {
        width: 28px;
        height: 28px;
        object-fit: contain;
        border-radius: 4px;
    }

    /* ── Links ─────────────────────────────────────────── */
    .nav-links {
        display: flex;
        list-style: none;
        gap: 0.25rem;
        margin: 0;
        flex: 1;
    }

    .nav-links a {
        color: var(--text-muted);
        font-size: 0.865rem;
        font-weight: 500;
        padding: 0.3rem 0.7rem;
        border-radius: 100px;
        transition:
            color 0.2s ease,
            background 0.2s ease;
    }

    .nav-links a:hover {
        color: var(--text);
        background: var(--border);
    }

    /* ── Controls ──────────────────────────────────────── */
    .nav-controls {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-left: auto;
        flex-shrink: 0;
    }

    .lang-switcher {
        display: flex;
        align-items: center;
        gap: 0.2rem;
    }

    .lang-btn {
        color: var(--text-faint);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        padding: 0.15rem 0.25rem;
        transition: color 0.2s ease;
    }

    .lang-btn:hover,
    .lang-btn.active {
        color: var(--accent-light);
    }

    .lang-sep {
        color: var(--text-faint);
        font-size: 0.7rem;
        opacity: 0.5;
    }

    .theme-toggle {
        background: none;
        border: 1px solid var(--border);
        border-radius: 50%;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--text-muted);
        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            background 0.2s ease;
        flex-shrink: 0;
    }

    .theme-toggle:hover {
        color: var(--accent-light);
        border-color: var(--accent);
        background: var(--accent-dim);
    }

    /* Sun / Moon visibility */
    :root[data-theme="dark"] .icon-sun,
    :root:not([data-theme]) .icon-sun {
        display: block;
    }
    :root[data-theme="dark"] .icon-moon,
    :root:not([data-theme]) .icon-moon {
        display: none;
    }
    :root[data-theme="light"] .icon-sun {
        display: none;
    }
    :root[data-theme="light"] .icon-moon {
        display: block;
    }

    /* ── Hamburger ─────────────────────────────────────── */
    .nav-hamburger {
        display: none;
        flex-direction: column;
        gap: 4px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        flex-shrink: 0;
    }

    .nav-hamburger span {
        display: block;
        width: 20px;
        height: 2px;
        background: var(--text-muted);
        border-radius: 2px;
        transition:
            transform 0.25s ease,
            opacity 0.25s ease;
    }

    .nav-hamburger.open span:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
    }
    .nav-hamburger.open span:nth-child(2) {
        opacity: 0;
    }
    .nav-hamburger.open span:nth-child(3) {
        transform: translateY(-6px) rotate(-45deg);
    }

    /* ── Mobile ────────────────────────────────────────── */
    @media (max-width: 768px) {
        .nav {
            pointer-events: auto;
            padding: 0.75rem 1rem 0;
        }

        .nav.scrolled {
            padding: 0 1rem;
        }

        .nav-pill {
            border-radius: 16px;
            padding: 0.55rem 1rem;
            gap: 0.5rem;
        }

        .nav-hamburger {
            display: flex;
        }

        .nav-links {
            display: none;
            position: absolute;
            top: calc(100% + 0.5rem);
            left: 0;
            right: 0;
            flex-direction: column;
            gap: 0;
            background: var(--nav-bg);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 0.5rem;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            z-index: 10;
        }

        .nav-links.open {
            display: flex;
        }

        .nav-links a {
            display: block;
            padding: 0.75rem 1rem;
            border-radius: 10px;
            font-size: 0.95rem;
        }

        .nav-controls {
            margin-left: auto;
            gap: 0.5rem;
        }

        .lang-switcher {
            gap: 0.1rem;
        }
    }
</style>
